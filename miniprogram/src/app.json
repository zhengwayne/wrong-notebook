      "name": "xueji",
      "pages": [
        "home/home",
        "notebook/notebook",
        "review/review",
        "capture/capture",
        "item/item",
        "parent/parent",
        "grade/grade",
        "guide/guide",
        "detail/detail",
        "question/question",
        "help/help"
      ]
    },
    {
      "root": "pkg-english",
      "name": "english",
      "pages": [
        "index/index",
        "practice/practice",
        "words/words"
      ]
    },
    {
      "root": "pkg-math",
      "name": "math",
      "pages": [
        "index/index",
        "lesson/lesson",
        "quiz/quiz",
        "badges/badges"
      ]
