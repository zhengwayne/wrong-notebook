/* 学迹小程序 · 薰衣草紫配色（与网页端一致，纯色、无渐变）
 * 字号与触控区域参照微信设计规范：正文 30rpx，可点区域高度不低于 88rpx（44px），页面左右边距 32rpx。 */
page {
  --xj-bg: #F6F5FB;
  --xj-fg: #23202E;
  --xj-card: #FFFFFF;
  --xj-primary: #6B5CA5;
  --xj-primary-press: #5A4C91;
  --xj-primary-fg: #FFFFFF;
  --xj-secondary: #F0EEF7;
  --xj-muted-fg: #8A8499;
  --xj-text-2: #5A5568;
  --xj-accent: #EEEAF8;
  --xj-accent-fg: #4A3D7A;
  --xj-border: #E8E5F2;
  --xj-danger: #A60028;
  --xj-danger-bg: #FBEAEE;
  --xj-success: #008C4D;
  --xj-success-bg: #E6F4EC;
  --xj-warning: #D88000;
  --xj-warning-bg: #FDF3E3;
  background-color: var(--xj-bg);
  color: var(--xj-fg);
  font-size: 30rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

.container { padding: 24rpx 32rpx 48rpx; box-sizing: border-box; }
.safe-bottom { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }

/* 卡片与标题 */
.card {
  background-color: var(--xj-card);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.card-title { display: flex; align-items: center; font-size: 32rpx; font-weight: 600; margin-bottom: 20rpx; }
.card-title .ic { margin-right: 12rpx; }
.muted { color: var(--xj-muted-fg); font-size: 26rpx; }
.text-2 { color: var(--xj-text-2); }
.danger { color: var(--xj-danger); }
.success { color: var(--xj-success); }
.warning { color: var(--xj-warning); }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; }
.gap { height: 20rpx; }
.wrap { display: flex; flex-wrap: wrap; }
.center { text-align: center; }

/* 图标：SVG 在 /assets/icons，颜色写在文件名后缀里 */
.ic { width: 40rpx; height: 40rpx; flex-shrink: 0; display: block; }
.ic-sm { width: 32rpx; height: 32rpx; }
.ic-lg { width: 56rpx; height: 56rpx; }
.ic-xl { width: 128rpx; height: 128rpx; }

/* 按钮 */
.btn {
  display: flex; align-items: center; justify-content: center;
  height: 96rpx; border-radius: 48rpx; font-size: 32rpx; font-weight: 600;
  background-color: var(--xj-primary); color: var(--xj-primary-fg);
  margin: 0; padding: 0 40rpx; border: none; line-height: 1;
}
.btn::after { border: none; }
.btn .ic { margin-right: 12rpx; }
.btn-hover { background-color: var(--xj-primary-press); }
.btn[disabled] { opacity: 0.45; background-color: var(--xj-primary) !important; color: var(--xj-primary-fg) !important; }
.btn-secondary { background-color: var(--xj-accent); color: var(--xj-accent-fg); }
.btn-secondary[disabled] { background-color: var(--xj-accent) !important; color: var(--xj-accent-fg) !important; }
.btn-outline { background-color: var(--xj-card); color: var(--xj-primary); border: 2rpx solid var(--xj-primary); }
.btn-outline[disabled] { background-color: var(--xj-card) !important; color: var(--xj-primary) !important; }
.btn-ghost { background-color: transparent; color: var(--xj-text-2); font-weight: 500; }
.btn-ghost[disabled] { background-color: transparent !important; color: var(--xj-text-2) !important; }
.btn-danger-text { background-color: transparent; color: var(--xj-danger); font-weight: 500; }
.btn-small { height: 72rpx; font-size: 28rpx; border-radius: 36rpx; padding: 0 28rpx; }
.btn-row { display: flex; gap: 20rpx; }
.btn-row .btn { flex: 1; }
.press { opacity: 0.7; }

/* 胶囊标签 */
.chip {
  display: inline-flex; align-items: center; height: 64rpx; box-sizing: border-box;
  padding: 0 26rpx; margin: 0 16rpx 16rpx 0; border-radius: 32rpx;
  background-color: var(--xj-card); color: var(--xj-text-2); font-size: 26rpx;
  border: 2rpx solid var(--xj-border);
}
.chip .ic { margin-right: 8rpx; }
.chip-active { background-color: var(--xj-primary); color: var(--xj-primary-fg); border-color: var(--xj-primary); }
.tag {
  display: inline-flex; align-items: center; padding: 4rpx 16rpx; margin: 0 12rpx 12rpx 0;
  border-radius: 10rpx; background-color: var(--xj-accent); color: var(--xj-accent-fg); font-size: 24rpx;
}

/* 掌握情况徽标 */
.badge { display: inline-flex; align-items: center; padding: 4rpx 16rpx 4rpx 10rpx; border-radius: 999rpx; font-size: 24rpx; flex-shrink: 0; }
.badge .ic { width: 28rpx; height: 28rpx; margin-right: 6rpx; }
.badge-new { background-color: var(--xj-warning-bg); color: var(--xj-warning); }
.badge-reviewing { background-color: var(--xj-accent); color: var(--xj-primary); }
.badge-mastered { background-color: var(--xj-success-bg); color: var(--xj-success); }

/* 输入 */
.input {
  height: 96rpx; padding: 0 28rpx; border-radius: 20rpx; box-sizing: border-box; font-size: 30rpx;
  background-color: var(--xj-secondary); margin-bottom: 20rpx;
}
.textarea {
  width: 100%; min-height: 160rpx; padding: 24rpx; border-radius: 20rpx; box-sizing: border-box;
  background-color: var(--xj-secondary); font-size: 30rpx;
}
.placeholder { color: var(--xj-muted-fg); }

/* 提示条 */
.banner {
  display: flex; align-items: center;
  background-color: var(--xj-accent); color: var(--xj-accent-fg);
  border-radius: 20rpx; padding: 20rpx 24rpx; margin-bottom: 24rpx; font-size: 26rpx;
}
.banner .ic { margin-right: 12rpx; }
.banner.danger { background-color: var(--xj-danger-bg); color: var(--xj-danger); }

/* 列表 */
.list-item { background-color: var(--xj-card); border-radius: 24rpx; padding: 28rpx 32rpx; margin-bottom: 20rpx; }
.list-item-text { font-size: 30rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.list-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }

/* 空状态与加载 */
.empty { display: flex; flex-direction: column; align-items: center; padding: 96rpx 0 64rpx; color: var(--xj-muted-fg); font-size: 28rpx; }
.empty .ic-xl { margin-bottom: 24rpx; }
.empty .btn { margin-top: 32rpx; }
.loading-row { display: flex; align-items: center; justify-content: center; padding: 40rpx 0; color: var(--xj-muted-fg); font-size: 26rpx; }
.spinner {
  width: 36rpx; height: 36rpx; border-radius: 50%; margin-right: 12rpx; box-sizing: border-box;
  border: 4rpx solid var(--xj-accent); border-top-color: var(--xj-primary);
  animation: xj-spin 0.8s linear infinite;
}
@keyframes xj-spin { to { transform: rotate(360deg); } }

/* 模型生成内容的标识 */
.section-label { font-size: 26rpx; color: var(--xj-muted-fg); margin: 24rpx 0 12rpx; }
.pre { white-space: pre-wrap; word-break: break-all; }
.divider { height: 1rpx; background-color: var(--xj-border); margin: 24rpx 0; }

/* 列表行（我的页等）：整行可点，高度 ≥ 96rpx */
.cell { display: flex; align-items: center; min-height: 104rpx; padding: 0 4rpx; }
.cell + .cell { border-top: 1rpx solid var(--xj-border); }
.cell .ic { margin-right: 20rpx; }
.cell-arrow { width: 32rpx; height: 32rpx; margin-left: 8rpx; }

/* 游客提示条：示例内容 + 登录入口（与专注锁条同一款式） */
.guest-bar {
  display: flex; align-items: center;
  background-color: var(--xj-accent); color: var(--xj-accent-fg);
  border-radius: 20rpx; padding: 12rpx 12rpx 12rpx 24rpx; margin-bottom: 24rpx; font-size: 26rpx;
}
.guest-btn {
  display: flex; align-items: center; height: 64rpx; padding: 0 20rpx; border-radius: 32rpx;
  background-color: var(--xj-card); color: var(--xj-primary); font-size: 26rpx; font-weight: 600;
}
.guest-btn .ic { margin-right: 6rpx; }

