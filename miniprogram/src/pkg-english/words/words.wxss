.seg { display: flex; padding: 6rpx; border-radius: 40rpx; background-color: var(--xj-secondary); margin-bottom: 24rpx; }
.seg-item { flex: 1; height: 68rpx; line-height: 68rpx; text-align: center; border-radius: 34rpx; font-size: 26rpx; color: var(--xj-text-2); }
.seg-on { background-color: var(--xj-card); color: var(--xj-primary); font-weight: 600; }
.w-name { font-size: 34rpx; font-weight: 600; }
.list-item .tag { margin: 0 12rpx 0 0; }
.save-all { margin-top: 24rpx; }
