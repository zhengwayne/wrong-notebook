.learner { font-size: 34rpx; font-weight: 600; margin-top: 4rpx; }
.due-count { font-size: 64rpx; font-weight: 700; color: var(--xj-primary); line-height: 1.3; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.grid-item {
  width: 48%; box-sizing: border-box; margin-bottom: 24rpx; padding: 28rpx;
  background-color: var(--xj-card); border: 1rpx solid var(--xj-border); border-radius: 24rpx;
}
.grid-title { font-size: 30rpx; font-weight: 600; color: var(--xj-accent-fg); margin-bottom: 8rpx; }
