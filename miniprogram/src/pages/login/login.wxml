<view class="page">
  <view class="hero">
    <view class="logo"><image class="logo-ic" src="/assets/icons/book-open-check-w.svg" /></view>
    <view class="brand-name">学迹</view>
    <view class="slogan">拍一拍，错题不再错</view>
    <view class="features">
      <view class="feature"><image class="ic" src="/assets/icons/camera-p.svg" /><text>拍题</text></view>
      <view class="feature"><image class="ic" src="/assets/icons/sparkles-p.svg" /><text>AI 讲解</text></view>
      <view class="feature"><image class="ic" src="/assets/icons/calendar-check-p.svg" /><text>按时复习</text></view>
    </view>
  </view>

  <view class="bottom">
    <view wx:if="{{error}}" class="banner danger"><image class="ic ic-sm" src="/assets/icons/triangle-alert-d.svg" />{{error}}</view>
    <button class="btn" disabled="{{loading}}" bindtap="onWechatLogin">
      <view wx:if="{{loading}}" class="spinner spinner-light"></view>
      {{loading ? '登录中' : '微信一键登录'}}
    </button>
    <view class="agree" bindtap="onToggleAgree">
      <view class="check {{agreed ? 'check-on' : ''}}"><image wx:if="{{agreed}}" class="check-ic" src="/assets/icons/check-w.svg" /></view>
      <text class="muted">已阅读并同意</text>
      <text class="link" catchtap="onOpenPrivacy">《用户隐私保护指引》</text>
    </view>
  </view>
</view>
