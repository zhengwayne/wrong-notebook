.page { min-height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; padding: 0 48rpx calc(48rpx + env(safe-area-inset-bottom)); }
.hero { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-top: 80rpx; }
.logo { width: 160rpx; height: 160rpx; border-radius: 44rpx; background-color: var(--xj-primary); display: flex; align-items: center; justify-content: center; }
.logo-ic { width: 96rpx; height: 96rpx; }
.brand-name { font-size: 56rpx; font-weight: 700; color: var(--xj-fg); margin-top: 32rpx; letter-spacing: 8rpx; }
.slogan { color: var(--xj-text-2); font-size: 30rpx; margin-top: 8rpx; }
.features { display: flex; justify-content: center; margin-top: 72rpx; }
.feature { display: flex; flex-direction: column; align-items: center; width: 180rpx; font-size: 26rpx; color: var(--xj-text-2); }
.feature .ic { width: 56rpx; height: 56rpx; margin-bottom: 12rpx; padding: 20rpx; border-radius: 28rpx; background-color: var(--xj-accent); }
.bottom { padding-bottom: 16rpx; }
.agree { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; min-height: 88rpx; margin-top: 16rpx; }
.check { width: 34rpx; height: 34rpx; border-radius: 50%; border: 2rpx solid var(--xj-muted-fg); margin-right: 10rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.check-on { background-color: var(--xj-primary); border-color: var(--xj-primary); }
.check-ic { width: 24rpx; height: 24rpx; }
.link { color: var(--xj-primary); font-size: 26rpx; }
.spinner-light { border-color: rgba(255, 255, 255, 0.35); border-top-color: #FFFFFF; }
