<view class="container safe-bottom">
  <kid-lock id="kid-lock" wx:if="{{kidMode}}" learner-name="{{learnerName}}" bind:unlocked="onKidUnlocked" />
  <view wx:if="{{error}}" class="banner danger"><image class="ic ic-sm" src="/assets/icons/triangle-alert-d.svg" />{{error}}</view>

  <view class="hub-head row-between">
    <picker wx:if="{{!kidMode && learnerOptions.length > 1}}" range="{{learnerOptions}}" range-key="name" value="{{learnerIndex}}" bindchange="onLearnerChange">
      <view class="learner-chip" id="learner-chip"><image class="ic ic-sm" src="/assets/icons/users-p.svg" /><text>{{learnerName}}</text><image class="ic ic-sm" src="/assets/icons/chevron-down-p.svg" /></view>
    </picker>
    <view wx:else class="learner-chip"><image class="ic ic-sm" src="/assets/icons/user-p.svg" /><text>{{learnerName || '我自己'}}</text></view>
    <view class="me-btn" hover-class="press" bindtap="onOpenMe" id="hub-me"><image class="ic" src="/assets/icons/user-p.svg" /><text>我的</text></view>
  </view>

  <view class="entry" hover-class="press" bindtap="onOpenEnglish" id="entry-english">
    <view class="entry-ic"><image class="entry-img" src="/assets/icons/languages-p.svg" /></view>
    <view class="flex-1">
      <view class="entry-title">学英语</view>
      <view class="entry-sub">{{englishDue > 0 ? '待复习 ' + englishDue + ' 词' : '拼单词'}}</view>
    </view>
    <image class="ic" src="/assets/icons/chevron-right-m.svg" />
  </view>

  <view class="entry" hover-class="press" bindtap="onOpenMath" id="entry-math">
    <view class="entry-ic"><image class="entry-img" src="/assets/icons/sigma-p.svg" /></view>
    <view class="flex-1">
      <view class="entry-title">学数学</view>
      <view class="entry-sub">{{mathStars > 0 ? '已点亮 ' + mathStars + ' 课' : '闯关点亮'}}</view>
    </view>
    <image class="ic" src="/assets/icons/chevron-right-m.svg" />
  </view>

  <view class="entry" hover-class="press" bindtap="onOpenXueji" id="entry-xueji">
    <view class="entry-ic"><image class="entry-img" src="/assets/icons/notebook-pen-p.svg" /></view>
    <view class="flex-1">
      <view class="entry-title">错题本</view>
      <view class="entry-sub">{{reviewDue > 0 ? '待复习 ' + reviewDue + ' 题' : '拍照收错题'}}</view>
    </view>
    <image class="ic" src="/assets/icons/chevron-right-m.svg" />
  </view>
</view>
