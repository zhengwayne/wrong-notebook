<view class="container">
  <view class="muted">{{learnerName}} 的错题，共 {{total}} 题</view>
  <view class="gap"></view>
  <input class="input" confirm-type="search" placeholder="搜题目、知识点或题号" value="{{query}}" bindconfirm="onSearch" />

  <scroll-view scroll-x class="filters">
    <view class="chip {{subjectId === '' ? 'chip-active' : ''}}" data-id="" bindtap="onSubject">全部错题本</view>
    <view wx:for="{{notebooks}}" wx:key="id" class="chip {{subjectId === item.id ? 'chip-active' : ''}}" data-id="{{item.id}}" bindtap="onSubject">{{item.name}}</view>
  </scroll-view>
  <view class="wrap">
    <view wx:for="{{masteryOptions}}" wx:key="value" class="chip {{mastery === item.value ? 'chip-active' : ''}}" data-value="{{item.value}}" bindtap="onMastery">{{item.label}}</view>
  </view>
  <view class="wrap">
    <view wx:for="{{timeOptions}}" wx:key="value" class="chip {{timeRange === item.value ? 'chip-active' : ''}}" data-value="{{item.value}}" bindtap="onTimeRange">{{item.label}}</view>
  </view>

  <view wx:if="{{error}}" class="banner danger">{{error}}</view>

  <view wx:for="{{items}}" wx:key="id" class="list-item" data-id="{{item.id}}" bindtap="onOpen">
    <view class="list-item-text">{{item.plain}}</view>
    <view class="row-between meta">
      <view class="wrap"><view wx:for="{{item.kps}}" wx:for-item="kp" wx:key="*this" class="chip">{{kp}}</view></view>
      <text class="status-{{item.masteryStatus}}">{{item.statusLabel}}</text>
    </view>
    <view class="muted">{{item.date}}</view>
  </view>

  <view wx:if="{{!loading && items.length === 0}}" class="empty">还没有符合条件的错题</view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:if="{{!loading && items.length > 0 && page >= totalPages}}" class="empty">没有更多了</view>
</view>
