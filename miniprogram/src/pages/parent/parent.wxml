<view class="container">
  <view wx:if="{{error}}" class="banner danger">{{error}}</view>

  <view wx:if="{{children.length === 0 && !loading}}" class="card">
    <view class="card-title">还没有孩子档案</view>
    <view class="muted">在「我的 → 添加孩子」里建一个档案，之后录入的错题会归到孩子名下。</view>
  </view>

  <block wx:if="{{child}}">
    <scroll-view scroll-x class="children">
      <view wx:for="{{children}}" wx:key="id" class="chip {{item.id === child.id ? 'chip-active' : ''}}" data-id="{{item.id}}" bindtap="onSwitchChild">{{item.name}}（{{item.itemCount}}）</view>
    </scroll-view>

    <view class="card">
      <view class="card-title">近 7 天练习</view>
      <view class="row-between">
        <view><view class="stat">{{child.practiceSummary.attempted}}</view><view class="muted">做题次数</view></view>
        <view><view class="stat">{{child.practiceSummary.correct}}</view><view class="muted">做对</view></view>
        <view><view class="stat">{{accuracy}}</view><view class="muted">正确率</view></view>
      </view>
      <view class="bars">
        <view wx:for="{{trend}}" wx:key="date" class="bar-col">
          <view class="bar-track"><view class="bar" style="height: {{item.height}}%"></view></view>
          <view class="bar-label">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">薄弱知识点</view>
      <view wx:if="{{child.weakPoints.length === 0}}" class="muted">暂时没有明显的薄弱点。</view>
      <view wx:for="{{weakPoints}}" wx:key="knowledgePoint" class="weak row-between">
        <text>{{item.knowledgePoint}}</text>
        <text class="muted">{{item.unmasteredCount}} 题未掌握 / 共 {{item.itemCount}} 题</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">今天的学习任务</view>
      <view wx:if="{{child.today.length === 0}}" class="muted">今天没有安排任务。</view>
      <view wx:for="{{child.today}}" wx:key="title" class="task">
        <view class="row-between"><text class="task-title">{{item.title}}</text><text class="muted">{{item.statusLabel}}</text></view>
        <view class="muted">{{item.reason}}</view>
      </view>
    </view>

    <view wx:if="{{child.latestPaper}}" class="card">
      <view class="card-title">最近一份试卷</view>
      <view>{{child.latestPaper.title || '未命名试卷'}}</view>
      <view class="muted">共 {{child.latestPaper.questionCount}} 题<text wx:if="{{child.latestPaper.correctCount !== null}}">，答对 {{child.latestPaper.correctCount}} 题</text></view>
      <view class="muted">整卷批改与订正请在网页端「家长 → 试卷」操作。</view>
    </view>

    <view class="card">
      <view class="card-title">导入老师的批改反馈</view>
      <view class="muted">老师在学迹里批改后会给出反馈二维码或链接，扫码即可把错题导入到 {{child.name}} 的错题本。</view>
      <view class="gap"></view>
      <button class="btn btn-outline" disabled="{{importing}}" bindtap="onScanFeedback">{{importing ? '导入中…' : '扫码导入'}}</button>
    </view>
  </block>
</view>
