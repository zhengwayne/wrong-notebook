.children { white-space: nowrap; margin-bottom: 16rpx; }
.children .chip { display: inline-flex; }
.stat { font-size: 44rpx; font-weight: 700; color: var(--xj-primary); }
.bars { display: flex; justify-content: space-between; margin-top: 28rpx; height: 200rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; }
.bar-track { flex: 1; width: 28rpx; display: flex; align-items: flex-end; background-color: var(--xj-secondary); border-radius: 8rpx; }
.bar { width: 100%; background-color: var(--xj-primary); border-radius: 8rpx; min-height: 4rpx; }
.bar-label { font-size: 20rpx; color: var(--xj-muted-fg); margin-top: 6rpx; }
.weak { padding: 14rpx 0; border-bottom: 1rpx solid var(--xj-border); }
.task { padding: 14rpx 0; border-bottom: 1rpx solid var(--xj-border); }
.task-title { font-weight: 600; }
