.pick { display: flex; flex-wrap: wrap; justify-content: space-between; padding-top: 24rpx; }
.pick-tile { width: calc(50% - 12rpx); height: 280rpx; box-sizing: border-box; border-radius: 32rpx; background-color: var(--xj-card); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.pick-main { width: 100%; height: 400rpx; margin-bottom: 24rpx; background-color: var(--xj-primary); color: #FFFFFF; }
.pick-tile:not(.pick-main) { width: 100%; height: 160rpx; flex-direction: row; }
.pick-label { font-size: 36rpx; font-weight: 600; margin-top: 16rpx; }
.pick-label-sm { font-size: 32rpx; font-weight: 600; margin-left: 16rpx; color: var(--xj-primary); }
.tips { width: 100%; margin-top: 32rpx; }
.tip { display: flex; align-items: center; color: var(--xj-text-2); font-size: 26rpx; margin-bottom: 12rpx; }
.tip .ic { margin-right: 10rpx; }

.pick-hint { font-size: 24rpx; color: var(--xj-text-2); margin-left: 12rpx; }

.grid-head { margin: 8rpx 0 16rpx; }
.grid-head .ic { margin-right: 10rpx; }
.grid-title { font-size: 32rpx; font-weight: 600; }
.link-muted { display: flex; align-items: center; min-height: 64rpx; padding: 0 8rpx; color: var(--xj-text-2); font-size: 26rpx; }
.link-muted .ic { margin-right: 8rpx; }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 12rpx; }
.thumb { position: relative; width: calc((100% - 32rpx) / 3); padding-top: calc((100% - 32rpx) / 3); border-radius: 20rpx; overflow: hidden; background-color: var(--xj-secondary); }
.thumb-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.thumb-add { background-color: var(--xj-card); border: 2rpx dashed var(--xj-muted-fg); box-sizing: border-box; }
.thumb-add .ic-lg { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); }
.thumb-no { position: absolute; left: 10rpx; top: 10rpx; min-width: 40rpx; height: 40rpx; padding: 0 8rpx; box-sizing: border-box; border-radius: 20rpx; background-color: rgba(35, 32, 46, 0.6); color: #FFFFFF; font-size: 24rpx; line-height: 40rpx; text-align: center; }
.thumb-x { position: absolute; right: 0; top: 0; width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.thumb-x .ic-xs { padding: 8rpx; border-radius: 50%; background-color: rgba(35, 32, 46, 0.6); }
.thumb-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background-color: rgba(35, 32, 46, 0.45); color: #FFFFFF; }
.thumb-mask.fail { background-color: rgba(166, 0, 40, 0.6); }
.thumb-retry { font-size: 24rpx; margin-top: 6rpx; }
.thumb-badge { position: absolute; right: 10rpx; bottom: 10rpx; display: flex; align-items: center; height: 40rpx; padding: 0 12rpx 0 8rpx; border-radius: 20rpx; color: #FFFFFF; font-size: 24rpx; }
.thumb-badge.ok { background-color: var(--xj-success); }
.thumb-badge .ic-xs { margin-right: 4rpx; }
.ic-xs { width: 28rpx; height: 28rpx; }
.spinner-w { border-color: rgba(255, 255, 255, 0.35); border-top-color: #FFFFFF; }
.hint { font-size: 24rpx; margin-bottom: 16rpx; }

.photo-tag { display: flex; align-items: center; margin-left: 12rpx; font-size: 24rpx; color: var(--xj-text-2); }
.photo-tag .ic-xs { margin-right: 4rpx; }
.subject-tag { margin-left: 12rpx; }
.q-text { position: relative; padding-right: 40rpx; margin-bottom: 8rpx; }
.edit-ic { position: absolute; right: 0; top: 4rpx; }
.done-edit { justify-content: flex-end; color: var(--xj-primary); }
.dest { padding-top: 4rpx; padding-bottom: 4rpx; }

.progress-card .row { margin-bottom: 20rpx; }
.progress-text { font-weight: 500; }
.progress-track { height: 12rpx; border-radius: 6rpx; background-color: var(--xj-accent); overflow: hidden; margin-bottom: 20rpx; }
.progress-bar { height: 100%; background-color: var(--xj-primary); border-radius: 6rpx; transition: width 0.9s linear; }

.result-head { margin: 8rpx 0 20rpx; }
.result-title { font-size: 34rpx; font-weight: 600; }
.q-card { border: 3rpx solid var(--xj-card); }
.q-on { border-color: var(--xj-primary); }
.q-head { min-height: 72rpx; margin-bottom: 16rpx; }
.q-no { font-weight: 600; }
.check { width: 40rpx; height: 40rpx; border-radius: 50%; border: 3rpx solid var(--xj-muted-fg); margin-right: 16rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.check-on { background-color: var(--xj-primary); border-color: var(--xj-primary); }
.check-ic { width: 28rpx; height: 28rpx; }
.kps { margin-top: 20rpx; }
.save-bar { position: sticky; bottom: 0; display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0 calc(12rpx + env(safe-area-inset-bottom)); background-color: var(--xj-bg); }
.badge-wrong { background-color: var(--xj-danger-bg); color: var(--xj-danger); }
.badge-blank { background-color: var(--xj-warning-bg); color: var(--xj-warning); }
.badge-unknown { background-color: var(--xj-secondary); color: var(--xj-text-2); }
.thumb-mask .spinner { margin-right: 0; }
