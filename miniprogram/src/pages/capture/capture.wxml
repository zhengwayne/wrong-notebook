<view class="container">
  <view wx:if="{{kidMode}}" class="banner">专注做题模式下不能录入错题，请家长先解锁。</view>

  <block wx:else>
    <view class="card">
      <view class="card-title">1. 选择题目照片</view>
      <view class="muted">一张照片可以包含多道题，AI 会逐题拆开。请尽量拍平、拍清楚。</view>
      <view class="gap"></view>
      <image wx:if="{{imagePath}}" class="preview" src="{{imagePath}}" mode="widthFix" bindtap="onPreview" />
      <view class="btn-row">
        <button class="btn btn-outline" data-source="camera" bindtap="onChoose">拍照</button>
        <button class="btn btn-outline" data-source="album" bindtap="onChoose">从相册选</button>
      </view>
    </view>

    <view class="card">
      <view class="card-title">2. 存到哪个错题本</view>
      <view class="muted">录给：{{learnerName}}</view>
      <view class="gap"></view>
      <picker range="{{notebooks}}" range-key="name" value="{{notebookIndex}}" bindchange="onNotebookChange">
        <view class="input picker">{{notebooks.length ? notebooks[notebookIndex].name : '加载中…'}}</view>
      </picker>
      <button class="btn" disabled="{{!imagePath || analyzing}}" bindtap="onAnalyze">{{analyzing ? 'AI 识别中，约半分钟…' : '开始识别'}}</button>
    </view>

    <view wx:if="{{error}}" class="banner danger">{{error}}</view>

    <block wx:if="{{items.length}}">
      <view class="section-label">3. 核对识别结果（勾选要保存的题）<text wx:if="{{failedCount}}" class="warning">，有 {{failedCount}} 题没识别出来</text></view>
      <view wx:for="{{items}}" wx:key="index" class="card">
        <view class="row-between">
          <checkbox-group data-index="{{index}}" bindchange="onToggleItem">
            <label class="row"><checkbox value="on" checked="{{item.selected}}" color="#6B5CA5" /><text>第 {{index + 1}} 题</text></label>
          </checkbox-group>
          <text class="muted">{{item.statusLabel}}</text>
        </view>
        <view class="section-label">题目（可修改）</view>
        <textarea class="textarea" auto-height maxlength="20000" value="{{item.questionText}}" data-index="{{index}}" bindinput="onEditQuestion" />
        <view class="section-label">答案</view>
        <view class="pre">{{item.answerPlain}}</view>
        <view wx:if="{{item.mistakePlain}}" class="section-label">错因</view>
        <view wx:if="{{item.mistakePlain}}" class="pre">{{item.mistakePlain}}</view>
        <view class="wrap tags"><view wx:for="{{item.knowledgePoints}}" wx:for-item="kp" wx:key="*this" class="chip">{{kp}}</view></view>
      </view>
      <button class="btn" disabled="{{saving}}" bindtap="onSave">{{saving ? '保存中…' : '保存到错题本'}}</button>
    </block>
  </block>
</view>
