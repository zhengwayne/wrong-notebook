.hero { width: 100%; height: 360rpx; border-radius: 28rpx; margin-bottom: 20rpx; background-color: var(--xj-accent); }
.l-head { margin-bottom: 20rpx; }
.l-title { font-size: 40rpx; font-weight: 700; margin-bottom: 8rpx; }
.lit-tag { color: var(--xj-warning); background-color: var(--xj-warning-bg); }
.point + .point { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--xj-border); }
.p-name { font-weight: 600; }
.p-desc { font-size: 28rpx; margin: 6rpx 0; }
.p-m { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; color: var(--xj-text-2); }
.foot { margin-top: 40rpx; text-align: center; font-size: 22rpx; }
