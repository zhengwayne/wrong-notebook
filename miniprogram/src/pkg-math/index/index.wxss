.summary { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 32rpx; border-radius: 28rpx; background-color: var(--xj-card); margin-bottom: 24rpx; }
.sum-num { font-size: 40rpx; font-weight: 700; line-height: 1.2; }
.badge-link { gap: 8rpx; color: var(--xj-primary); font-size: 26rpx; }
.camps { white-space: nowrap; }
.station { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 28rpx; border-radius: 24rpx; background-color: var(--xj-card); margin-bottom: 16rpx; }
.st-no { width: 64rpx; height: 64rpx; border-radius: 32rpx; background-color: var(--xj-accent); color: var(--xj-accent-fg); display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 600; flex-shrink: 0; }
.st-lit { background-color: var(--xj-primary); }
.st-title { font-size: 30rpx; }
.foot { margin-top: 40rpx; text-align: center; font-size: 22rpx; }
