.children { white-space: nowrap; margin-bottom: 8rpx; }
.children .chip { display: inline-flex; }
.stats { display: flex; }
.stat-box { flex: 1; text-align: center; }
.stat { font-size: 48rpx; font-weight: 700; color: var(--xj-primary); line-height: 1.3; }
.stat-ok { color: var(--xj-success); }
.bars { display: flex; justify-content: space-between; margin-top: 32rpx; height: 200rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; }
.bar-track { flex: 1; width: 28rpx; display: flex; align-items: flex-end; background-color: var(--xj-secondary); border-radius: 14rpx; overflow: hidden; }
.bar { width: 100%; background-color: var(--xj-primary); border-radius: 14rpx; min-height: 6rpx; }
.bar-label { font-size: 20rpx; color: var(--xj-muted-fg); margin-top: 8rpx; }
.weak { padding: 16rpx 0; }
.weak-name { font-size: 28rpx; }
.weak-track { height: 10rpx; border-radius: 5rpx; background-color: var(--xj-secondary); margin-top: 10rpx; overflow: hidden; }
.weak-bar { height: 100%; background-color: var(--xj-warning); border-radius: 5rpx; }
.task { display: flex; align-items: flex-start; padding: 16rpx 0; }
.task + .task { border-top: 1rpx solid var(--xj-border); }
.task .ic { margin: 4rpx 16rpx 0 0; }
.task-title { font-weight: 500; }
.paper-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 16rpx; }
.mini-empty { display: flex; align-items: center; color: var(--xj-text-2); font-size: 26rpx; }
.mini-empty .ic { margin-right: 10rpx; }
