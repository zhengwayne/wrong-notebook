<web-view wx:if="{{src && !failed}}" src="{{src}}" binderror="onWebError" />
<view wx:elif="{{failed}}" class="container">
  <view class="card fail">
    <image class="ic-xl" src="/assets/icons/triangle-alert-l.svg" />
    <view class="muted fail-hint">{{hint}}</view>
    <view class="btn-row">
      <button class="btn btn-small" disabled="{{!path}}" bindtap="onCopy" id="btn-webview-copy"><image class="ic ic-sm" src="/assets/icons/copy-w.svg" />复制链接</button>
      <button class="btn btn-small btn-secondary" bindtap="onBack">返回</button>
    </view>
  </view>
</view>
<view wx:else class="loading-row page-loading"><view class="spinner"></view>打开中</view>
