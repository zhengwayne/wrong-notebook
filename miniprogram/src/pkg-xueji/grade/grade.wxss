.wait { display: flex; flex-direction: column; align-items: center; padding: 64rpx 32rpx; text-align: center; }
.wait-spin { width: 64rpx; height: 64rpx; margin: 0 0 24rpx; border-width: 6rpx; }
.wait-text { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.wait-hint { margin-top: 24rpx; line-height: 1.6; }
.fail-text { margin: 0 32rpx; text-align: center; }

.sum { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.sum-cell { flex: 1; display: flex; align-items: center; justify-content: center; height: 88rpx; border-radius: 20rpx; background-color: var(--xj-card); }
.sum-cell .ic { width: 36rpx; height: 36rpx; margin-right: 8rpx; }
.sum-n { font-size: 34rpx; font-weight: 700; margin-right: 8rpx; }
.sum-label { font-size: 24rpx; color: var(--xj-muted-fg); }
.v-correct .sum-n { color: var(--xj-success); }
.v-partial .sum-n { color: var(--xj-warning); }
.v-wrong .sum-n { color: var(--xj-danger); }

.hint { margin: 0 4rpx 20rpx; }
.done-head { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.done-head .ic { margin-right: 12rpx; }
.done .muted { margin-top: 6rpx; }
.done-btns { margin-top: 24rpx; }

.q { padding: 24rpx 28rpx; border-left: 8rpx solid transparent; }
.q.correct { border-left-color: var(--xj-success); }
.q.partial { border-left-color: var(--xj-warning); }
.q.wrong { border-left-color: var(--xj-danger); }
.q-head { margin-bottom: 12rpx; }
.q-no { min-width: 48rpx; font-size: 30rpx; font-weight: 700; color: var(--xj-primary); }
.page-tag, .low-tag, .in-tag { display: flex; align-items: center; margin-left: 12rpx; padding: 2rpx 12rpx; border-radius: 999rpx; font-size: 22rpx; }
.page-tag { background-color: var(--xj-secondary); color: var(--xj-muted-fg); }
.low-tag { background-color: var(--xj-warning-bg); color: var(--xj-warning); }
.in-tag { background-color: var(--xj-accent); color: var(--xj-primary); }
.page-tag .ic-xs, .low-tag .ic-xs, .in-tag .ic-xs { margin-right: 4rpx; }

.seg { display: flex; border-radius: 16rpx; background-color: var(--xj-secondary); padding: 4rpx; flex-shrink: 0; }
.seg-busy { opacity: 0.6; }
.seg-btn { width: 80rpx; height: 64rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; }
.seg-btn .ic { width: 36rpx; height: 36rpx; }
.seg-on.v-correct { background-color: var(--xj-success); }
.seg-on.v-partial { background-color: var(--xj-warning); }
.seg-on.v-wrong { background-color: var(--xj-danger); }
.seg-off { opacity: 0.85; }

.q-text { font-size: 29rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-all; }
.clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.ans { margin-top: 10rpx; font-size: 26rpx; color: var(--xj-text-2); align-items: flex-start; }
.ans .ic { margin: 4rpx 10rpx 0 0; }
.one-line { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.cause { margin-top: 12rpx; padding: 16rpx 20rpx; border-radius: 16rpx; background-color: var(--xj-danger-bg); color: var(--xj-danger); font-size: 26rpx; line-height: 1.5; }

.save-bar { position: sticky; bottom: 0; display: flex; padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom)); background-color: var(--xj-bg); }
.ic-xs { width: 28rpx; height: 28rpx; }
