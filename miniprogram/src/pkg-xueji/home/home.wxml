<view class="container">
  <kid-lock id="kid-lock" wx:if="{{kidMode}}" learner-name="{{learnerName}}" bind:unlocked="onKidUnlocked" />
  <view wx:if="{{error}}" class="banner danger"><image class="ic ic-sm" src="/assets/icons/triangle-alert-d.svg" />{{error}}</view>

  <!-- 第一次进来：选身份 -->
  <block wx:if="{{needPersona}}">
    <view class="welcome">
      <view class="welcome-title">欢迎来到学迹</view>
      <view class="muted">你是？（可多选）</view>
    </view>
    <view class="persona-grid">
      <view wx:for="{{personaOptions}}" wx:key="value" class="persona {{item.checked ? 'persona-on' : ''}}" hover-class="press" data-value="{{item.value}}" bindtap="onTogglePersona">
        <image class="ic-lg" src="{{item.checked ? item.iconOn : item.icon}}" />
        <view class="persona-label">{{item.label}}</view>
        <view class="persona-hint">{{item.hint}}</view>
        <image wx:if="{{item.checked}}" class="persona-check" src="/assets/icons/circle-check-p.svg" />
      </view>
    </view>
    <button class="btn" disabled="{{saving}}" bindtap="onSavePersona">开始使用</button>
  </block>

  <block wx:elif="{{ready}}">
    <!-- 问候 + 当前学习者 -->
    <view class="head row-between">
      <view class="flex-1">
        <view class="hello">{{greeting}}，{{displayName}}</view>
      </view>
      <picker wx:if="{{!kidMode && learnerOptions.length > 1}}" range="{{learnerOptions}}" range-key="name" value="{{learnerIndex}}" bindchange="onLearnerChange">
        <view class="learner-chip"><image class="ic ic-sm" src="/assets/icons/users-p.svg" /><text>{{learnerName}}</text><image class="ic ic-sm" src="/assets/icons/chevron-down-p.svg" /></view>
      </picker>
      <view wx:elif="{{learnerOptions.length > 1}}" class="learner-chip"><image class="ic ic-sm" src="/assets/icons/users-p.svg" /><text>{{learnerName}}</text></view>
    </view>

    <!-- 新手引导（进度和电脑端同步） -->
    <xj-guide wx:if="{{guidePersona}}" persona="{{guidePersona}}" refresh="{{guideRefresh}}" />

    <!-- 老师：收卷进度 -->
    <view wx:if="{{isTeacher && collectLoaded}}" class="card collect">
      <block wx:if="{{collect}}">
        <view class="row-between">
          <view class="card-title collect-title"><image class="ic" src="/assets/icons/clipboard-check-p.svg" />{{collect.title}}</view>
          <text class="muted">{{collect.className}}</text>
        </view>
        <view class="row collect-nums">
          <view class="collect-num"><text class="collect-big">{{collect.submitted}}</text><text class="muted">/{{collect.total}}</text><view class="muted">已交</view></view>
          <view class="collect-num"><text class="collect-big">{{collect.confirmed}}</text><view class="muted">已确认</view></view>
        </view>
        <view wx:if="{{collect.submitted === 0}}" class="muted">还没有答卷。可以开启扫码交卷，把二维码发到班级群</view>
      </block>
      <block wx:else>
        <view class="card-title collect-title"><image class="ic" src="/assets/icons/clipboard-check-p.svg" />收卷进度</view>
        <view class="muted">还没有改卷任务。建好班级、新建改卷后，这里显示已交和已确认人数</view>
      </block>
    </view>

    <!-- 今日复习 -->
    <view class="due-card" hover-class="press" bindtap="onOpenReview">
      <view class="flex-1">
        <view class="due-label">今日待复习</view>
        <view class="due-count">{{dueTotal}}<text class="due-unit">题</text></view>
      </view>
      <view wx:if="{{dueTotal > 0}}" class="due-go"><image class="ic" src="/assets/icons/arrow-right-p.svg" /></view>
      <view wx:else class="due-done"><image class="ic-lg" src="/assets/icons/party-popper-w.svg" /></view>
    </view>

    <!-- 功能入口 -->
    <view class="grid">
      <view wx:if="{{!kidMode}}" class="tile tile-main" hover-class="press" bindtap="onCapture">
        <image class="ic-lg" src="/assets/icons/camera-w.svg" />
        <view class="tile-label">拍题</view>
      </view>
      <view class="tile" hover-class="press" bindtap="onOpenNotebook">
        <image class="ic-lg" src="/assets/icons/book-open-p.svg" />
        <view class="tile-label">错题本</view>
      </view>
      <view class="tile" hover-class="press" bindtap="onOpenReview">
        <image class="ic-lg" src="/assets/icons/calendar-check-p.svg" />
        <view class="tile-label">复习</view>
      </view>
      <view wx:if="{{isParent && !kidMode}}" class="tile" hover-class="press" bindtap="onOpenParent">
        <image class="ic-lg" src="/assets/icons/chart-column-p.svg" />
        <view class="tile-label">学情</view>
      </view>
    </view>
  </block>

  <view wx:elif="{{!error}}" class="loading-row"><view class="spinner"></view>加载中</view>
</view>
<xj-tabbar id="xj-tabbar" active="home" />
