.guide { padding: 28rpx 28rpx 12rpx; }
.guide-head { display: flex; align-items: center; }
.guide-badge { width: 64rpx; height: 64rpx; border-radius: 18rpx; background-color: var(--xj-accent); display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; }
.guide-title { font-size: 32rpx; font-weight: 600; }
.guide-sub { font-size: 24rpx; }
.guide-count { margin: 0 20rpx 0 12rpx; font-size: 24rpx; }
.guide-collapse { color: var(--xj-primary); font-size: 26rpx; padding: 12rpx 0 12rpx 8rpx; }
.guide-bar { height: 10rpx; border-radius: 5rpx; background-color: var(--xj-secondary); margin: 20rpx 0 4rpx; overflow: hidden; }
.guide-bar-fill { height: 100%; background-color: var(--xj-primary); border-radius: 5rpx; }
.guide-step { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 2rpx solid var(--xj-border); }
.guide-step:last-child { border-bottom: none; }
.guide-dot { width: 48rpx; height: 48rpx; border-radius: 24rpx; background-color: var(--xj-secondary); color: var(--xj-muted-fg); font-size: 24rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; box-sizing: border-box; }
.dot-done { background-color: var(--xj-primary); color: var(--xj-primary-fg); }
.dot-on { border: 4rpx solid var(--xj-primary); color: var(--xj-primary); background-color: var(--xj-accent); }
.guide-step-title { font-size: 28rpx; color: var(--xj-text-2); }
.guide-step-on .guide-step-title { color: var(--xj-fg); font-weight: 600; }
.guide-step-desc { font-size: 24rpx; line-height: 1.4; }
.guide-note { font-size: 24rpx; margin-left: 12rpx; max-width: 220rpx; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.guide-btn { display: flex; align-items: center; height: 64rpx; padding: 0 24rpx; border-radius: 32rpx; background-color: var(--xj-primary); color: var(--xj-primary-fg); font-size: 26rpx; font-weight: 600; margin-left: 16rpx; flex-shrink: 0; }
.guide-btn .ic-sm { margin-right: 8rpx; }
.guide-finish { display: flex; align-items: center; padding: 20rpx 20rpx; margin: 8rpx 0 16rpx; border-radius: 20rpx; background-color: var(--xj-accent); }

.sheet-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(35, 32, 46, 0.45); z-index: 1000; display: flex; align-items: flex-end; }
.sheet { width: 100%; background-color: var(--xj-card); border-radius: 32rpx 32rpx 0 0; padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sheet-title { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.sheet-desc { font-size: 26rpx; }
.sheet-url { margin: 20rpx 0 12rpx; padding: 20rpx 24rpx; border-radius: 20rpx; background-color: var(--xj-bg); font-size: 24rpx; color: var(--xj-text-2); word-break: break-all; min-height: 48rpx; }
.sheet-tip { font-size: 24rpx; margin-bottom: 24rpx; }
.sheet-here { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-top: 24rpx; color: var(--xj-primary); font-size: 26rpx; }
