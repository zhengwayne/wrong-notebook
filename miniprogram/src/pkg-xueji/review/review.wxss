.hero { display: flex; flex-direction: column; align-items: center; padding: 40rpx 0 40rpx; }
.hero-count { font-size: 120rpx; font-weight: 700; color: var(--xj-primary); line-height: 1.1; }
.hero-unit { font-size: 32rpx; font-weight: 500; margin-left: 8rpx; color: var(--xj-text-2); }
.start { width: 440rpx; margin-top: 32rpx; }
.round { display: flex; align-items: center; color: var(--xj-muted-fg); font-size: 24rpx; }
.round .ic { margin-right: 8rpx; }
.done { padding-top: 160rpx; }
.done-title { font-size: 36rpx; font-weight: 600; color: var(--xj-fg); margin-bottom: 8rpx; }
