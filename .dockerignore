# 镜像内的部署回归测试需要读取 Dockerfile、忽略规则和 HTTPS Compose 示例
docker-compose*.yml
!docker-compose.yml
!docker-compose.https.yml

# 依赖和构建产物
node_modules
npm-debug.log
.next
.next-*
dist

# 版本控制
.git
.gitignore

# 环境配置
.env
.env.*
!.env.example
# 配置、证书和用户数据只在运行时挂载
config
certs
data
outputs

# 构建阶段运行单元/集成测试；最终 standalone 镜像不复制测试目录
coverage

# E2E 测试文件 (Playwright)
e2e
playwright-report
test-results
blob-report
test_output*.txt

# 开发工具
.vscode
.idea
*.log
.github
.gitea
__pycache__
*.pyc
*.tsbuildinfo

# 只把迁移和种子代码送入镜像，开发库、WAL 和任意命名的备份均留在宿主机
prisma/*
!prisma/schema.prisma
!prisma/seed.ts
!prisma/migrations
**/*.db
**/*.db-*
**/*.db.*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3

# 文档
README.md
docs
doc
