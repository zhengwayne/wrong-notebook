// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  educationStage String? // primary, junior_high, senior_high, university
  enrollmentYear Int?
  gradeRecognitionMode String @default("fixed") // 录入年级规则：fixed 固定，ai 按题目识别
  fixedGradeSemester String? // 固定年级学期，未指定时沿用账户当前年级

  role      String   @default("user") // "admin" or "user"
  isActive  Boolean  @default(true)   // 用户是否启用

  confirmBeforeImport Boolean @default(false) // 导入题目前是否进入人工校对页
  questionDuplicateThreshold Float @default(90) // 百分比，相似度严格大于此值时判重
  masteryThreshold Int @default(50) // 百分比，掌握概率达到此值视为已掌握
  variantPipelineEnabled Boolean @default(true) // 举一反三走分阶段流水线；关闭后使用原来的一次生成
  enableGeogebra Boolean @default(false) // 是否显示 GeoGebra 动态演示
  enableSvgAnimation Boolean @default(true) // 是否显示 SVG 动画讲解
  themePreference String @default("system") // 界面主题：system 跟随系统、light 浅色、dark 深色

  errorItems ErrorItem[]
  subjects   Subject[]
  practiceRecords PracticeRecord[]
  customTags KnowledgeTag[] // User's custom tags
  examPapers ExamPaper[]
  aiUsages   AiUsage[]
  gradingClasses GradingClass[]
  gradingTasks   GradingTask[]
  variantRuns    VariantRun[]
}

// 统一知识点标签表 (支持无限层级)
model KnowledgeTag {
  id        String   @id @default(cuid())
  name      String   // 标签名，如 "勾股定理"
  subject   String   // 学科，如 "math", "english"

  // 层级控制 (邻接表模式)
  parentId  String?
  parent    KnowledgeTag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  KnowledgeTag[] @relation("TagHierarchy")

  // 排序与编码
  order     Int      @default(0) // 用于保持教材顺序
  code      String?              // 如 "1.2.1"

  // 区分系统预设 vs 用户自定义
  isSystem  Boolean  @default(false)
  userId    String?  // 如果是用户自定义标签，绑定 userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 与错题的多对多关系
  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 联合索引：确保同一用户（或系统）下同一父节点下的标签名不重复
  @@unique([subject, name, userId, parentId])
  // 索引：加速父子查询
  @@index([parentId])
  @@index([subject])
}

model Subject {
  id         String  @id @default(cuid())
  name       String
  stage      String  @default("primary") // 学段：primary / junior_high / senior_high，仅创建时设置
  subjectKey String? // 学科：math / english / physics 等，仅创建时设置；为空时按名称推断
  userId     String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
  
  @@index([userId])
}

model ErrorItem {
  id             String   @id @default(cuid())
  shortId        String?  @unique // 6 位 base58 短 ID，创建后不变
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  originalImageUrl String
  ocrText          String?
  
  // AI Analysis
  questionText     String? // Parsed question
  answerText       String? // AI provided answer
  analysis         String? // AI analysis/explanation
  wrongAnswerText  String? // Student's wrong answer/work if visible
  mistakeAnalysis  String? // Analysis of why the wrong answer happened
  mistakeStatus    String? // not_attempted, wrong_attempt, unknown
  knowledgePoints  String? // [DEPRECATED] JSON string - kept for migration only
  geogebraCommands String? // GeoGebra commands for interactive demo (JSON or newline-separated)
  svgAnimation     String? // AI 生成的 SVG 动画讲解（已净化），中文版
  svgAnimationEn   String? // 英文版 SVG 动画讲解（已净化），界面为英文时使用

  // New: many-to-many relation with KnowledgeTag
  tags             KnowledgeTag[]
  
  // User Metadata
  source           String? // e.g. "Midterm Exam"
  errorType        String? // e.g. "Calculation", "Concept"
  userNotes        String?
  
  masteryLevel     Int     @default(0) // 0: New, 1: Reviewing, 2: Mastered
  gradeSemester    String? // e.g. "Junior High Grade 2, 1st Semester"
  paperLevel       String? // e.g. "A", "B", "Other"
  difficultyStars  Int?    // 难度星级 1~5（参考高思导引星级），未评定时为空
  hasFigure        Boolean @default(false) // 识别时判断题目是否有配图
  figureSvg        String? // AI 用 SVG 重绘的题目配图（已净化），显示和打印时使用
  lastPractice     String? // 最近一次生成的举一反三题目与解答（JSON），再次进入练习页时直接显示

  // 根据举一反三历史推测的掌握情况
  masteryProbability Float?    // 0~1
  masteryReason      String?
  masterySource      String?   // ai | rule
  masteryEvaluatedAt DateTime?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reviewSchedules ReviewSchedule[]
  practiceRecords PracticeRecord[]
  examQuestions   ExamQuestion[]
  variantRuns     VariantRun[]

  // 列表、统计都按用户取错题并按时间排序；SQLite 不会自动给外键建索引
  @@index([userId, createdAt])
  @@index([subjectId])
}

model ReviewSchedule {
  id          String    @id @default(cuid())
  errorItemId String
  errorItem   ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)
  
  scheduledFor DateTime
  completedAt  DateTime?
  isCorrect    Boolean? // Result of the review
  
  createdAt    DateTime @default(now())
  
  @@index([errorItemId])
}

model PracticeRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject   String?  // e.g. "Math", "Physics"
  difficulty String? // "easy", "medium", "hard", "harder"
  isCorrect Boolean?

  // 举一反三记录：关联原题，保存生成的题目与结果
  errorItemId  String?
  errorItem    ErrorItem? @relation(fields: [errorItemId], references: [id], onDelete: Cascade)
  result       String?  // correct | wrong | not_attempted
  questionText String?
  answerText   String?
  analysis     String?
  wrongAnswerText String? // 本次作答快照，避免重复导入时覆盖原题
  mistakeAnalysis String?
  originalImageUrl String?
  figureSvg    String?  // 举一反三新题的 SVG 配图
  source       String   @default("practice") // practice | manual | exam | duplicate_import
  // 试卷题目可多次录入结果，每次一条记录
  examQuestionId String?
  examQuestion   ExamQuestion? @relation(fields: [examQuestionId], references: [id], onDelete: SetNull)
  
  createdAt DateTime @default(now())

  @@index([errorItemId, createdAt])
  @@index([examQuestionId])
  @@index([userId, createdAt])
  variantItems VariantItem[]
}

// 随机错题试卷
model ExamPaper {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  status     String   @default("generating") // generating | ready | partial | failed
  scope      String   // unmastered | mastered | all
  difficulty String   // easy | medium | hard | harder
  requestedCount Int
  subjectIds String   // JSON 数组
  tagNames   String?  // JSON 数组
  resultsRecordedAt DateTime?

  questions  ExamQuestion[]
  variantRuns VariantRun[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
}

model ExamQuestion {
  id            String     @id @default(cuid())
  paperId       String
  paper         ExamPaper  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  order         Int
  errorItemId   String?
  errorItem     ErrorItem? @relation(fields: [errorItemId], references: [id], onDelete: SetNull)
  sourceShortId String     // 来源题目短 ID 快照，原题删除后仍保留
  status        String     @default("pending") // pending | ready | failed
  questionText  String?
  answerText    String?
  analysis      String?
  figureSvg     String?    // 新题的 SVG 配图
  error         String?
  practiceRecordId String? // [DEPRECATED] 旧版一对一关联，部署校验要求保留已有列，改用 PracticeRecord.examQuestionId
  practiceRecords PracticeRecord[]
  variantItems    VariantItem[]

  @@index([paperId, order])
}

// 用户发起的 AI 调用记录，用于每日额度和用量统计（不含后台自动的掌握概率评估）
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // analyze | reanswer | practice | grade | figure | latex | geogebra | animation | exam | retag
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ===== 老师收卷拍照改卷 =====

// 班级（老师自己的花名册）
model GradingClass {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  students  GradingStudent[]
  tasks     GradingTask[]
  variantRuns VariantRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

// 花名册中的学生；错题导入老师账户下以学生命名的错题本
model GradingStudent {
  id          String   @id @default(cuid())
  classId     String
  class       GradingClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name        String
  studentNo   String?  // 学号，班级内唯一；导入名册时按 班级+学号 更新
  order       Int      @default(0)
  submissions GradingSubmission[]
  variantRuns VariantRun[]
  createdAt   DateTime @default(now())

  @@unique([classId, studentNo])
  @@index([classId, order])
  @@index([classId, name])
}

// 一次改卷任务（某班某次考试）
model GradingTask {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId     String
  class       GradingClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  title       String
  subjectName String   @default("数学") // 导入错题时使用的学科名
  examPaperId String?  // 从已有试卷生成答案时记录来源
  keyImageUrl String?  // 拍照识别的答案卷（压缩后的 data URL）
  extraClassIds String? // JSON 数组：同一次考试一起收卷的其他班级
  questions   GradingKeyQuestion[]
  submissions GradingSubmission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([classId])
}

// 标准答案中的一道题
model GradingKeyQuestion {
  id              String  @id @default(cuid())
  taskId          String
  task            GradingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  order           Int
  number          String  // 题号，如 "1"、"13(2)"
  type            String  @default("objective") // objective 客观题 | subjective 主观题
  maxScore        Float   @default(1)
  answer          String  @default("")
  acceptedAnswers String? // JSON 数组：其他可接受的答案写法
  questionText    String?
  knowledgePoints String? // JSON 数组
  results         GradingResult[]

  @@index([taskId, order])
}

// 一位学生的一份答卷（可多页）
model GradingSubmission {
  id           String   @id @default(cuid())
  taskId       String
  task         GradingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId    String?
  student      GradingStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  detectedName String?  // AI 从卷面读出的姓名
  detectedClass String? // AI 从卷面读出的班级
  detectedStudentNo String? // AI 从卷面读出的学号
  matchStatus  String?  // auto 自动匹配 | review 待确认 | manual 老师指定
  matchConfidence Float? // 自动匹配置信度 0~1
  matchReason  String?  // JSON：匹配原因代码与参数
  matchCandidates String? // JSON 数组：待确认时的候选学生 [{studentId, confidence, reason}]
  images       String   // JSON 数组：压缩后的 data URL，每页一张
  status       String   @default("pending") // pending | grading | graded | failed | confirmed
  totalScore   Float?
  error        String?
  confirmedAt  DateTime?
  importedCount Int     @default(0) // 确认后导入错题本的题目数
  results      GradingResult[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([taskId, createdAt])
  @@index([studentId])
}

// 一道题的判分结果
model GradingResult {
  id            String  @id @default(cuid())
  submissionId  String
  submission    GradingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  keyQuestionId String
  keyQuestion   GradingKeyQuestion @relation(fields: [keyQuestionId], references: [id], onDelete: Cascade)
  studentAnswer String?
  verdict       String  // correct | partial | wrong | blank
  score         Float   @default(0)
  aiScore       Float?  // AI 建议分（主观题）
  reason        String?
  source        String  @default("auto") // auto 本地比对 | ai | teacher 老师改判
  errorItemId   String? // 导入错题本后的错题 ID

  @@unique([submissionId, keyQuestionId])
  @@index([keyQuestionId])
}

// ===== 变式题分阶段生成与审核（借鉴 DeepTutor 先规划再逐题生成的流程，独立实现） =====

model VariantRun {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String   // practice | personalized_set | topic | class_topic | legacy
  mode        String   // pipeline | legacy
  status      String   @default("running") // running | completed | failed
  language    String   @default("zh")
  targetDifficulty String?
  requestedCount Int   @default(1)
  title       String?
  errorItemId String?
  errorItem   ErrorItem? @relation(fields: [errorItemId], references: [id], onDelete: SetNull)
  studentId   String?
  student     GradingStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  classId     String?
  class       GradingClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  subjectId   String?
  examPaperId String?
  examPaper   ExamPaper? @relation(fields: [examPaperId], references: [id], onDelete: SetNull)
  inputSnapshot   String? // JSON：脱敏原题、知识点、错因、目标难度等
  weaknessProfile String? // JSON：学情弱点画像
  topicSuggestion String? // JSON：专题课题建议
  totalLatencyMs  Int?
  promptTokens    Int?
  completionTokens Int?
  totalTokens     Int?
  cost            Float?
  error           String?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  items           VariantItem[]
  stages          VariantStageLog[]

  @@index([userId, startedAt])
  @@index([errorItemId])
  @@index([studentId])
  @@index([classId])
}

model VariantItem {
  id          String   @id @default(cuid())
  runId       String
  run         VariantRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  index       Int
  status      String   @default("pending_review") // verified | pending_review | rejected | approved
  plan        String?  // JSON：变什么、针对哪项技能、规划难度
  questionText String?
  answerText   String?
  analysis     String?
  figureSvg    String?
  knowledgePoints String? // JSON 数组
  plannedDifficulty String?
  checkedDifficulty String?
  difficultyConsistent Boolean?
  verification String? // JSON：验算与重解证据
  similarity   Float?
  similarTo    String?
  sourceItemId String? // 生成所依据的原错题
  practiceRecordId String? @unique
  practiceRecord   PracticeRecord? @relation(fields: [practiceRecordId], references: [id], onDelete: SetNull)
  examQuestionId String?
  examQuestion   ExamQuestion? @relation(fields: [examQuestionId], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  stages       VariantStageLog[]

  @@index([runId, index])
  @@index([status])
}

model VariantStageLog {
  id        String   @id @default(cuid())
  runId     String
  run       VariantRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId    String?
  item      VariantItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stage     String   // plan | generate | verify | dedup | difficulty | resolve | review | topic | profile
  status    String   // ok | failed | skipped | review
  latencyMs Int?
  promptTokens Int?
  completionTokens Int?
  totalTokens Int?
  cost      Float?
  detail    String?  // JSON
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}

