// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  educationStage String? // primary, junior_high, senior_high, university
  enrollmentYear Int?
  gradeRecognitionMode String @default("fixed") // 录入年级规则：fixed 固定，ai 按题目识别
  fixedGradeSemester String? // 固定年级学期，未指定时沿用账户当前年级

  role        String   @default("user") // "admin" or "user"
  isActive    Boolean  @default(true)   // 用户是否启用
  authVersion Int      @default(0)      // 会话版本号：改密、禁用或权限变更后递增，令旧 JWT 立即失效

  /// JSON 数组：teacher / parent / self，未确认前为 []
  personas             String    @default("[]")
  /// 当前使用的身份，未确认前为空
  activePersona        String?
  /// 首次确认身份的时间；为空则下次登录需要一次性确认
  personasConfirmedAt  DateTime?
  /// 新手引导状态 JSON：{ dismissed: { teacher: ISO }, completedAt: { teacher: ISO } }
  onboardingState      String    @default("{}")

  confirmBeforeImport Boolean @default(false) // 导入题目前是否进入人工校对页
  questionDuplicateThreshold Float @default(90) // 百分比，相似度严格大于此值时判重
  masteryThreshold Int @default(50) // 百分比，掌握概率达到此值视为已掌握
  variantPipelineEnabled Boolean @default(true) // 举一反三走分阶段流水线；关闭后使用原来的一次生成
  enableGeogebra Boolean @default(false) // 是否显示 GeoGebra 动态演示
  enableSvgAnimation Boolean @default(true) // 是否显示 SVG 动画讲解
  themePreference String @default("system") // 界面主题：system 跟随系统、light 浅色、dark 深色
  reviewAlgorithmVersion String @default("ebbinghaus-v1") // 逐题复习算法：ebbinghaus-v1 | fsrs-v1

  /// 家长专注做题模式 4 位 PIN 码的 bcrypt 哈希（不随普通查询或备份导出）
  parentPinHash        String?
  parentPinFailedCount Int       @default(0)
  parentPinLockedUntil DateTime?

  errorItems ErrorItem[]
  subjects   Subject[]
  practiceRecords PracticeRecord[]
  customTags KnowledgeTag[] // User's custom tags
  examPapers ExamPaper[]
  aiUsages   AiUsage[]
  gradingClasses GradingClass[]
  gradingTasks   GradingTask[]
  variantRuns    VariantRun[]
  knowledgeMasteries KnowledgeMastery[]
  learningPaths LearningPath[]
  learners     Learner[]
  parentPapers ParentPaper[]
  dailyHomeworks DailyHomeworkItem[]
  itemMemories ItemMemory[]
  sourceImports SourceImport[]
  asyncOperations AsyncOperation[]
  aiDailyQuotas   AiDailyQuota[]
  wechatBindings  WechatBinding[]
  miniProgramSessions MiniProgramSession[]
  webHandoffTokens WebHandoffToken[]
}

// 统一知识点标签表 (支持无限层级)
model KnowledgeTag {
  id        String   @id @default(cuid())
  name      String   // 标签名，如 "勾股定理"
  subject   String   // 学科，如 "math", "english"

  // 层级控制 (邻接表模式)
  parentId  String?
  parent    KnowledgeTag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  KnowledgeTag[] @relation("TagHierarchy")

  // 排序与编码
  order     Int      @default(0) // 用于保持教材顺序
  code      String?              // 如 "1.2.1"

  // 区分系统预设 vs 用户自定义
  isSystem  Boolean  @default(false)
  userId    String?  // 如果是用户自定义标签，绑定 userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 与错题的多对多关系
  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 联合索引：确保同一用户（或系统）下同一父节点下的标签名不重复
  @@unique([subject, name, userId, parentId])
  // 索引：加速父子查询
  @@index([parentId])
  @@index([subject])
}

model Subject {
  id         String  @id @default(cuid())
  name       String
  stage      String  @default("primary") // 学段：primary / junior_high / senior_high，仅创建时设置
  subjectKey String? // 学科：math / english / physics 等，仅创建时设置；为空时按名称推断
  userId     String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
  
  @@index([userId])
}

model ErrorItem {
  id             String   @id @default(cuid())
  shortId        String?  @unique // 6 位 base58 短 ID，创建后不变
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  originalImageUrl String
  ocrText          String?
  
  // AI Analysis
  questionText     String? // Parsed question
  answerText       String? // AI provided answer
  analysis         String? // AI analysis/explanation
  wrongAnswerText  String? // Student's wrong answer/work if visible
  mistakeAnalysis  String? // Analysis of why the wrong answer happened
  mistakeStatus    String? // not_attempted, wrong_attempt, unknown
  knowledgePoints  String? // [DEPRECATED] JSON string - kept for migration only
  geogebraCommands String? // GeoGebra commands for interactive demo (JSON or newline-separated)
  svgAnimation     String? // AI 生成的 SVG 动画讲解（已净化），中文版
  svgAnimationEn   String? // 英文版 SVG 动画讲解（已净化），界面为英文时使用

  // New: many-to-many relation with KnowledgeTag
  tags             KnowledgeTag[]
  
  // User Metadata
  source           String? // e.g. "Midterm Exam"
  errorType        String? // e.g. "Calculation", "Concept"
  userNotes        String?
  
  masteryLevel     Int     @default(0) // 0: New, 1: Reviewing, 2: Mastered
  gradeSemester    String? // e.g. "Junior High Grade 2, 1st Semester"
  paperLevel       String? // e.g. "A", "B", "Other"
  difficultyStars  Int?    // 难度星级 1~5（参考高思导引星级），未评定时为空
  hasFigure        Boolean @default(false) // 识别时判断题目是否有配图
  figureSvg        String? // AI 用 SVG 重绘的题目配图（已净化），显示和打印时使用
  lastPractice     String? // 最近一次生成的举一反三题目与解答（JSON），再次进入练习页时直接显示

  // 根据举一反三历史推测的掌握情况
  masteryProbability Float?    // 0~1
  masteryReason      String?
  masterySource      String?   // ai | rule
  masteryEvaluatedAt DateTime?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  learnerId        String?
  learner          Learner?  @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  provenanceId     String?

  reviewSchedules ReviewSchedule[]
  practiceRecords PracticeRecord[]
  examQuestions   ExamQuestion[]
  variantRuns     VariantRun[]
  itemMemories    ItemMemory[]

  // 列表、统计都按用户取错题并按时间排序；SQLite 不会自动给外键建索引
  @@index([userId, createdAt])
  @@index([subjectId])
  @@index([learnerId])
}

model ReviewSchedule {
  id          String    @id @default(cuid())
  errorItemId String
  errorItem   ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)
  
  scheduledFor DateTime
  completedAt  DateTime?
  isCorrect    Boolean? // Result of the review
  
  createdAt    DateTime @default(now())
  
  @@index([errorItemId])
}

model PracticeRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject   String?  // e.g. "Math", "Physics"
  difficulty String? // "easy", "medium", "hard", "harder"
  isCorrect Boolean?

  // 举一反三记录：关联原题，保存生成的题目与结果
  errorItemId  String?
  errorItem    ErrorItem? @relation(fields: [errorItemId], references: [id], onDelete: Cascade)
  result       String?  // correct | wrong | not_attempted
  questionText String?
  answerText   String?
  analysis     String?
  wrongAnswerText String? // 本次作答快照，避免重复导入时覆盖原题
  mistakeAnalysis String?
  originalImageUrl String?
  figureSvg    String?  // 举一反三新题的 SVG 配图
  source       String   @default("practice") // practice | manual | exam | duplicate_import
  // 试卷题目可多次录入结果，每次一条记录
  examQuestionId String?
  examQuestion   ExamQuestion? @relation(fields: [examQuestionId], references: [id], onDelete: SetNull)
  
  learnerId  String?
  learner    Learner?  @relation(fields: [learnerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([errorItemId, createdAt])
  @@index([examQuestionId])
  @@index([userId, createdAt])
  @@index([learnerId])
  variantItems VariantItem[]
}

// 随机错题试卷
model ExamPaper {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnerId  String?
  learner    Learner? @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  title      String
  status     String   @default("generating") // generating | ready | partial | failed
  scope      String   // unmastered | mastered | all
  difficulty String   // easy | medium | hard | harder
  requestedCount Int
  subjectIds String   // JSON 数组
  tagNames   String?  // JSON 数组
  resultsRecordedAt DateTime?

  questions  ExamQuestion[]
  variantRuns VariantRun[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, learnerId, createdAt])
}

model ExamQuestion {
  id            String     @id @default(cuid())
  paperId       String
  paper         ExamPaper  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  order         Int
  errorItemId   String?
  errorItem     ErrorItem? @relation(fields: [errorItemId], references: [id], onDelete: SetNull)
  sourceShortId String     // 来源题目短 ID 快照，原题删除后仍保留
  status        String     @default("pending") // pending | ready | failed
  questionText  String?
  answerText    String?
  analysis      String?
  figureSvg     String?    // 新题的 SVG 配图
  error         String?
  practiceRecordId String? // [DEPRECATED] 旧版一对一关联，部署校验要求保留已有列，改用 PracticeRecord.examQuestionId
  practiceRecords PracticeRecord[]
  variantItems    VariantItem[]

  @@index([paperId, order])
}

// 用户发起的 AI 调用记录，用于每日额度和用量统计（不含后台自动的掌握概率评估）
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String    // analyze | reanswer | practice | grade | figure | latex | geogebra | animation | exam | retag | mastery
  // reserved：已预留、结果未定；confirmed：成功，计入次数；released：失败已退回；expired：超时未结算已自动退回
  status     String    @default("confirmed")
  dayKey     String?   // 预留所在的应用时区日期（YYYY-MM-DD），退回时扣回这一天
  requestKey String?   // 同一请求编号只预留一次
  ref        String?   // 后台任务关联（如 parent-paper:<id>），任务结束时按它结算
  settledAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([ref])
}

// ===== 老师收卷拍照改卷 =====

// 班级（老师自己的花名册）
model GradingClass {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  students  GradingStudent[]
  tasks     GradingTask[]
  variantRuns VariantRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

// 花名册中的学生；错题导入老师账户下以学生命名的错题本
model GradingStudent {
  id          String   @id @default(cuid())
  classId     String
  class       GradingClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name        String
  studentNo   String?  // 学号，班级内唯一；导入名册时按 班级+学号 更新
  order       Int      @default(0)
  submissions GradingSubmission[]
  variantRuns VariantRun[]
  learner     Learner?
  createdAt   DateTime @default(now())

  @@unique([classId, studentNo])
  @@index([classId, order])
  @@index([classId, name])
}

// 一次改卷任务（某班某次考试）
model GradingTask {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId         String
  class           GradingClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  title           String
  subjectName     String    @default("数学") // 导入错题时使用的学科名
  taskMode        String    @default("standard") // standard 标准答案模式 | quick 随堂无答案速批
  scoringMode     String    @default("numeric")  // numeric 数值分制 | grade 等级制(优/良/合格/待订正)
  deadline        DateTime?
  allowSelfSubmit Boolean   @default(false)
  submitTokenHash String?   @unique
  examPaperId     String?   // 从已有试卷生成答案时记录来源
  keyImageUrl     String?   // 拍照识别的答案卷（压缩后的 data URL）
  extraClassIds   String?   // JSON 数组：同一次考试一起收卷的其他班级
  questions       GradingKeyQuestion[]
  submissions     GradingSubmission[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([classId])
}

// 标准答案中的一道题
model GradingKeyQuestion {
  id              String  @id @default(cuid())
  taskId          String
  task            GradingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  order           Int
  number          String  // 题号，如 "1"、"13(2)"
  type            String  @default("objective") // objective 客观题 | subjective 主观题
  maxScore        Float   @default(1)
  answer          String  @default("")
  answerSource    String  @default("manual") // manual | exam_paper | key_image | ai_inferred
  acceptedAnswers String? // JSON 数组：其他可接受的答案写法
  questionText    String?
  knowledgePoints String? // JSON 数组
  results         GradingResult[]

  @@index([taskId, order])
}

// 一位学生的一份答卷（可多页）
model GradingSubmission {
  id                String    @id @default(cuid())
  taskId            String
  task              GradingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId         String?
  student           GradingStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  detectedName      String?   // AI 从卷面读出的姓名
  detectedClass     String?   // AI 从卷面读出的班级
  detectedStudentNo String?   // AI 从卷面读出的学号
  matchStatus       String?   // auto 自动匹配 | review 待确认 | manual 老师指定
  matchConfidence   Float?    // 自动匹配置信度 0~1
  matchReason       String?   // JSON：匹配原因代码与参数
  matchCandidates   String?   // JSON 数组：待确认时的候选学生 [{studentId, confidence, reason}]
  images            String    // JSON 数组：压缩后的 data URL，每页一张
  status            String    @default("pending") // pending | grading | graded | failed | confirmed
  reviewBucket      String    @default("yellow")  // green 绿灯免检 | yellow 黄灯待复核
  handwritingLevel  String?   // excellent | good | fair | needs_work
  neatnessLevel     String?   // excellent | good | fair | needs_work
  attitudeLevel     String?   // excellent | good | fair | needs_work
  processTags       String?   // JSON 数组：快捷评价胶囊 key
  visualAlerts      String?   // JSON 数组：AI 宏观视觉异常预警
  teacherComment    String?   // 答卷级综合评语
  shareTokenHash    String?   @unique
  shareExpiresAt    DateTime?
  version           Int       @default(0) // 乐观锁版本号：修改判分、指定学生或确认入库时递增
  totalScore        Float?
  error             String?
  confirmedAt       DateTime?
  importedCount     Int       @default(0) // 确认后导入错题本的题目数
  results           GradingResult[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([taskId, createdAt])
  @@index([studentId])
}

// 一道题的判分结果
model GradingResult {
  id            String  @id @default(cuid())
  submissionId  String
  submission    GradingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  keyQuestionId String
  keyQuestion   GradingKeyQuestion @relation(fields: [keyQuestionId], references: [id], onDelete: Cascade)
  studentAnswer String?
  verdict       String  // correct | partial | wrong | blank
  score         Float   @default(0)
  aiScore       Float?  // AI 建议分（主观题）
  confidence    Float?  // AI 识别与初判把握度 0~1
  bbox          String? // 归一化题框 JSON：{ pageIndex, x, y, width, height }
  reason        String?
  comment       String? // 老师单题文字批注
  source        String  @default("auto") // auto 本地比对 | ai | teacher 老师改判
  errorItemId   String? // 导入错题本后的错题 ID
  provenanceId  String?

  @@unique([submissionId, keyQuestionId])
  @@index([keyQuestionId])
}

// ===== 变式题分阶段生成与审核（借鉴 DeepTutor 先规划再逐题生成的流程，独立实现） =====

model VariantRun {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String   // practice | personalized_set | topic | class_topic | legacy
  mode        String   // pipeline | legacy
  status      String   @default("running") // running | completed | failed
  language    String   @default("zh")
  targetDifficulty String?
  requestedCount Int   @default(1)
  title       String?
  errorItemId String?
  errorItem   ErrorItem? @relation(fields: [errorItemId], references: [id], onDelete: SetNull)
  studentId   String?
  student     GradingStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  classId     String?
  class       GradingClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  subjectId   String?
  examPaperId String?
  examPaper   ExamPaper? @relation(fields: [examPaperId], references: [id], onDelete: SetNull)
  inputSnapshot   String? // JSON：脱敏原题、知识点、错因、目标难度等
  weaknessProfile String? // JSON：学情弱点画像
  topicSuggestion String? // JSON：专题课题建议
  totalLatencyMs  Int?
  promptTokens    Int?
  completionTokens Int?
  totalTokens     Int?
  cost            Float?
  error           String?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  items           VariantItem[]
  stages          VariantStageLog[]

  @@index([userId, startedAt])
  @@index([errorItemId])
  @@index([studentId])
  @@index([classId])
}

model VariantItem {
  id          String   @id @default(cuid())
  runId       String
  run         VariantRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  index       Int
  status      String   @default("pending_review") // verified | pending_review | rejected | approved
  plan        String?  // JSON：变什么、针对哪项技能、规划难度
  questionText String?
  answerText   String?
  analysis     String?
  figureSvg    String?
  knowledgePoints String? // JSON 数组
  plannedDifficulty String?
  checkedDifficulty String?
  difficultyConsistent Boolean?
  verification String? // JSON：验算与重解证据
  similarity   Float?
  similarTo    String?
  sourceItemId String? // 生成所依据的原错题
  practiceRecordId String? @unique
  practiceRecord   PracticeRecord? @relation(fields: [practiceRecordId], references: [id], onDelete: SetNull)
  examQuestionId String?
  examQuestion   ExamQuestion? @relation(fields: [examQuestionId], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?
  provenanceId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  stages       VariantStageLog[]

  @@index([runId, index])
  @@index([status])
}

model VariantStageLog {
  id        String   @id @default(cuid())
  runId     String
  run       VariantRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId    String?
  item      VariantItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stage     String   // plan | generate | verify | dedup | difficulty | resolve | review | topic | profile
  status    String   // ok | failed | skipped | review
  latencyMs Int?
  promptTokens Int?
  completionTokens Int?
  totalTokens Int?
  cost      Float?
  detail    String?  // JSON
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}


// ===== 学习路径：知识点掌握模型与分步路径（借鉴 DeepTutor Mastery Path 的阶段门与复述复习，独立实现） =====

// 学习者：本人（默认，错题可不挂 learnerId）、家长名下的孩子（每户最多 3 个）、老师花名册学生
model Learner {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// self | child | student
  kind             String
  name             String
  /// 老师的学生：对应花名册，studentKey 仍用 GradingStudent.id
  gradingStudentId String?  @unique
  gradingStudent   GradingStudent? @relation(fields: [gradingStudentId], references: [id], onDelete: SetNull)
  order            Int      @default(0)
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  errorItems      ErrorItem[]
  practiceRecords PracticeRecord[]
  parentPapers    ParentPaper[]
  dailyHomeworks  DailyHomeworkItem[]
  itemMemories    ItemMemory[]
  examPapers      ExamPaper[]

  @@index([userId, kind])
}

// 回填审计：只记录本次脚本改过的行，便于原样撤回，不删除任何错题
model LearnerBackfillAudit {
  id                String   @id @default(cuid())
  batchId           String
  userId            String
  entityType        String   // learner | errorItem | practiceRecord
  entityId          String
  action            String   // create | link
  previousLearnerId String?
  newLearnerId      String?
  createdAt         DateTime @default(now())

  @@index([batchId])
  @@index([entityType, entityId])
}


// 家长为孩子上传的试卷：先存为待识别草稿，确认前不写入错题本
model ParentPaper {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnerId String
  learner   Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  title     String?
  /// 家长选择的学科：math / chinese 等，对应 NOTEBOOK_SUBJECTS
  subjectKey String?
  /// pending_recognition | recognizing | pending_confirmation | confirmed | failed
  status    String   @default("pending_recognition")
  /// 乐观锁版本号：编辑单题判定/框选或确认入库时递增
  version   Int      @default(0)
  /// 可选答案卷照片，JSON 数组（data URL）
  answerKeyImages String?
  hasAnswerKey    Boolean  @default(false)
  handwritingLevel String?
  neatnessLevel    String?
  attitudeLevel    String?
  processTags      String?
  parentComment    String?
  errorMessage    String?
  recognizedAt    DateTime?
  confirmedAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pages     ParentPaperPage[]
  questions ParentPaperQuestion[]

  @@index([userId, learnerId, createdAt])
  @@index([userId, status])
}

model ParentPaperPage {
  id               String   @id @default(cuid())
  paperId          String
  paper            ParentPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  position         Int
  imageUrl         String
  originalImageUrl String?
  createdAt        DateTime @default(now())

  @@index([paperId, position])
}


/// 家长试卷识别出的题目：确认前不写入错题本
model ParentPaperQuestion {
  id                  String   @id @default(cuid())
  paperId             String
  paper               ParentPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  position            Int
  number              String
  /// objective | subjective
  type                String   @default("objective")
  questionText        String   @default("")
  studentAnswer       String   @default("")
  correctAnswer       String   @default("")
  /// correct | wrong | partial
  verdict             String
  overrideVerdict     String?
  confidence          Float    @default(0)
  errorCause          String?
  knowledgePoints     String   @default("[]")
  /// 归一化 bbox JSON：{ pageIndex, x, y, width, height }，无效时为空
  bbox                String?
  subjectHint         String?
  importedErrorItemId String?
  provenanceId        String?
  selected            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([paperId, position])
}

model KnowledgeMastery {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentKey     String   // "self" 或花名册学生 id
  knowledgePoint String
  pKnown         Float    @default(0.3) // BKT 掌握概率
  retrievability Float    @default(1)
  stabilityDays  Float    @default(1)
  evidenceCount  Int      @default(0)
  lastCorrect    Boolean?
  lastObservedAt DateTime?
  dueAt          DateTime?
  updatedAt      DateTime @updatedAt

  @@unique([userId, studentKey, knowledgePoint])
  @@index([userId, studentKey])
  @@index([userId, dueAt])
}

model LearningPath {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentKey   String
  studentName  String
  classId      String?
  version      Int      @default(1)
  status       String   @default("active") // active | completed
  evidenceHash String
  planReason   String?
  aiSuggestCount Int    @default(0)
  aiSuggestedAt  DateTime?
  plannedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  steps        LearningPathStep[]

  @@unique([userId, studentKey])
  @@index([userId, classId])
}

model LearningPathStep {
  id              String    @id @default(cuid())
  pathId          String
  path            LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  position        Int
  type            String    // review_explanation | variant_practice | spaced_review | checkpoint
  title           String
  reason          String
  knowledgePoints String    // JSON 数组
  errorItemIds    String?   // JSON 数组
  variantRunId    String?
  status          String    @default("pending") // pending | in_progress | completed | skipped
  locked          Boolean   @default(false)
  dueAt           DateTime?
  href            String?
  teacherNote     String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([pathId, position])
}

/// AI 产出记录的提示词、模型与解析器溯源（相同组合复用同一行）
model AiProvenance {
  id            String   @id @default(cuid())
  task          String   // analyze | grade | exam-read | variant | reanswer
  provider      String   // gemini | openai | azure | anthropic | 渠道预设名
  model         String
  promptVersion String   // prompts.ts 中对应提示词规范化文本的 SHA-256 前 12 位
  parserVersion String   // 解析与校验逻辑版本
  createdAt     DateTime @default(now())

  @@unique([task, provider, model, promptVersion, parserVersion])
}

/// 逐题记忆模型状态（FSRS 风格参数，可完全由 PracticeRecord 重算）
model ItemMemory {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnerId        String?
  learner          Learner?  @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  scopeKey         String    @default("self")
  errorItemId      String
  errorItem        ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)
  stability        Float     @default(1)
  difficulty       Float     @default(5)
  lastReviewAt     DateTime?
  dueAt            DateTime
  reps             Int       @default(0)
  lapses           Int       @default(0)
  algorithmVersion String    @default("fsrs-v1")
  updatedAt        DateTime  @updatedAt

  @@unique([userId, scopeKey, errorItemId, algorithmVersion])
  @@index([userId, scopeKey, dueAt])
  @@index([errorItemId])
}

/// 批量改卷与家长试卷确认入库去重索引：确保同一源题目在并发确认下至多生成一条错题
model SourceImport {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceKind       String   // parent_paper | grading_submission
  sourceId         String
  sourceQuestionId String
  errorItemId      String
  createdAt        DateTime @default(now())

  @@unique([userId, sourceKind, sourceQuestionId])
  @@index([userId, sourceKind, sourceId])
  @@index([errorItemId])
}

/// 统一异步作业、幂等操作与断线可恢复请求状态表
model AsyncOperation {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopeKey       String    @default("") // 非空作用域键：避免 SQLite 唯一索引下 NULL 不互斥
  category       String    // idempotent | recoverable | task
  kind           String
  idempotencyKey String
  requestHash    String?
  status         String    @default("running") // running | succeeded | failed | interrupted
  statusCode     Int?
  subject        String?
  link           String?
  progressJson   String?
  responseJson   String?
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  expiresAt      DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([scopeKey, category, kind, idempotencyKey])
  @@index([userId, category, status, startedAt])
  @@index([expiresAt])
}

/// 用户按应用时区自然日统计的 AI 调用原子计数表
model AiDailyQuota {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey    String   // YYYY-MM-DD（应用时区）
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, dayKey])
  @@index([dayKey])
}

/// 家长每日全科作业待办项
model DailyHomeworkItem {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnerId        String
  learner          Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  dateKey          String    // YYYY-MM-DD（应用时区）
  subjectKey       String    @default("math")
  category         String    @default("written") // written 书面 | recitation 背诵 | dictation 听写 | review 错题复习
  title            String
  estimatedMinutes Int?
  actualMinutes    Int?
  completed        Boolean   @default(false)
  completedAt      DateTime?
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, learnerId, dateKey])
}

/// 微信小程序 openid 与现有账号的绑定（同一小程序内一个 openid 只对应一个账号，一个账号只绑一个 openid）
model WechatBinding {
  id          String    @id @default(cuid())
  appId       String
  openid      String
  unionid     String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  @@unique([appId, openid])
  @@unique([appId, userId])
  @@index([userId])
}

/// 小程序登录会话：只保存令牌的 SHA-256 摘要；改密/禁用（authVersion 变化）或解绑后立即失效
model MiniProgramSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId       String
  openid      String
  authVersion Int
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([appId, openid])
  @@index([expiresAt])
}

/// 小程序「查看详情」一次性网页登录令牌：只存 SHA-256 摘要，约 5 分钟过期，用一次即作废，绑定账号与目标页面
model WebHandoffToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 签发时所用的小程序会话；兑换时该会话须仍有效
  mpSessionId  String
  /// 目标页面（站内相对路径）
  nextPath     String
  authVersion  Int
  /// 签发时小程序处于孩子专注锁：保存同一把已签名的锁，兑换时写入浏览器，网页端沿用同样的限制
  kidLock      String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
