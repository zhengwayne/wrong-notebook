# 数据库连接地址
# 本地开发通常使用 SQLite，路径相对于 prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# SQLite 日志模式：默认 WAL（可选 WAL / DELETE / TRUNCATE / PERSIST / MEMORY / OFF）
# 若在 NAS 上使用 NFS/CIFS 网络卷挂载数据目录，建议改为 DELETE 或 TRUNCATE
# SQLITE_JOURNAL_MODE="WAL"
# 每日数据库一致性快照开关与保留份数（默认开启，保留最近 7 份到 backups/）
# Docker 部署若已使用宿主机卷快照，可设为 false 关闭
# DAILY_SNAPSHOT_ENABLED="true"
# DAILY_SNAPSHOT_RETENTION="7"
# 网页备份 ZIP 上传上限（正整数字节，默认 2 GiB）；解压总上限会自动至少不低于该值
# BACKUP_MAX_UPLOAD_BYTES="2147483648"

# NextAuth 会话加密密钥
# 首次部署用 openssl rand -hex 32 生成独立值；升级和重建时保留该值。
NEXTAUTH_SECRET=""

# 配置文件 app-config.json 所在目录（可选，默认为 ./config）
# CONFIG_DIR="./config"

# 应用的基础 URL
# 本地开发通常是 http://localhost:3000
# 生产环境如果使用 Docker 且 IP 不固定，建议注释掉此项并启用 AUTH_TRUST_HOST
# NEXTAUTH_URL="http://localhost:3000"

# 信任 Host 请求头
# 设置为 true 时，NextAuth 会根据请求头自动推断 URL，适合 Docker/PaaS 环境
AUTH_TRUST_HOST=true

# 代理 IP 头信任模式（控制登录/注册等 IP 限流来源识别）
# - "false"（默认）：忽略一切 X-Forwarded-For / X-Real-IP / CF-Connecting-IP，防止直连伪造绕过限流
# - "true"：配合 Nginx/Caddy 等反向代理，按 TRUSTED_PROXY_HOPS 从 X-Forwarded-For 末端取可信客户端 IP
# - "cloudflare"：在 Cloudflare 代理后优先读取 CF-Connecting-IP
# TRUST_PROXY="false"
# 可信反向代理层数（仅 TRUST_PROXY="true" 或回退时生效，默认 1）
# TRUSTED_PROXY_HOPS="1"

# 是否允许新用户注册（默认 false）。网页中「设置 → 用户管理」保存的开关优先
# ALLOW_REGISTRATION=false

# 普通用户每天可发起的 AI 操作次数（默认 0，不限制；管理员不受限制）。网页中「设置 → 用户管理」保存的值优先
# AI_DAILY_LIMIT=0

# 同一模型同时进行的 AI 调用上限（默认 5，范围 1～100），超出的调用排队，避免服务商返回 429。网页中「设置 → 用户管理」保存的值优先
# AI_CONCURRENCY_LIMIT=5

# 动画语音讲解的朗读方式（默认 browser）：browser 为浏览器本地语音；minimax、qwen、glm、stepfun、volcengine、volcengine-agent、openai 为云端语音，复用下方对应渠道的 API Key。
# 网页中「设置 → AI 设置 → 语音讲解」保存的值优先
# TTS_MODE=browser
# 火山引擎豆包语音的 API Key（与火山方舟的 Key 不同，在豆包语音控制台创建）
# VOLCENGINE_TTS_API_KEY=""

# AI 服务提供商配置
# 可选值: "minimax" (默认)、"minimax-code"、"glm"、"deepseek"、"kimi"、"qwen"、"stepfun"、"volcengine"、"volcengine-agent"、"volcengine-coding"、"volcengine-free"、"siliconflow"、"siliconflow-global"、"anthropic"、"azure"、"openai"、"gemini"
AI_PROVIDER="minimax"

# 国产大模型官方渠道（OpenAI 兼容接口，BASE_URL 和 MODEL 可选，留空使用官方默认值）
# MiniMax (当 AI_PROVIDER="minimax" 时需要)
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="" # 默认为 https://api.minimax.cn/v1，国际站为 https://api.minimax.io/v1
MINIMAX_MODEL="" # 默认为 MiniMax-M3.1-Flash
# 智谱 GLM (当 AI_PROVIDER="glm" 时需要)
GLM_API_KEY=""
GLM_BASE_URL="" # 默认为 https://open.bigmodel.cn/api/paas/v4，国际站为 https://api.z.ai/api/paas/v4
GLM_MODEL="" # 默认为 glm-5.3-flash
# DeepSeek (当 AI_PROVIDER="deepseek" 时需要)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="" # 默认为 https://api.deepseek.com
DEEPSEEK_MODEL="" # 默认为 deepseek-v4-flash
# Kimi (当 AI_PROVIDER="kimi" 时需要)
KIMI_API_KEY=""
KIMI_BASE_URL="" # 默认为 https://api.moonshot.cn/v1，国际站为 https://api.moonshot.ai/v1
KIMI_MODEL="" # 默认为 kimi-k3.1-pro
# 千问 Qwen (当 AI_PROVIDER="qwen" 时需要；推荐阿里云百炼 Token Plan，Key 以 sk-sp- 开头)
QWEN_API_KEY=""
QWEN_BASE_URL="" # 默认为 Token Plan 地址 https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1，按量付费的 Key 填 https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL="" # 默认为 qwen3.8-max
# 阶跃星辰 StepFun (当 AI_PROVIDER="stepfun" 时需要；推荐 Step Plan 套餐)
STEPFUN_API_KEY=""
STEPFUN_BASE_URL="" # 默认为 Step Plan 套餐地址 https://api.stepfun.com/step_plan/v1（推荐，含语音合成），按量付费为 https://api.stepfun.com/v1，国际站为 https://api.stepfun.ai/v1
STEPFUN_MODEL="" # 默认为 step-5-preview
# 火山引擎 豆包 (当 AI_PROVIDER="volcengine" 时需要；按量付费，订阅套餐时使用下方对应的套餐渠道)
VOLCENGINE_API_KEY=""
VOLCENGINE_BASE_URL="" # 默认为 https://ark.cn-beijing.volces.com/api/v3，国际站（BytePlus）为 https://ark.ap-southeast.bytepluses.com/api/v3
VOLCENGINE_MODEL="" # 默认为 doubao-seed-evolving
# 火山引擎 Agent Plan (当 AI_PROVIDER="volcengine-agent" 时需要)：Agent Plan 管理页的专属 API Key，套餐含豆包语音合成
VOLCENGINE_AGENT_API_KEY=""
VOLCENGINE_AGENT_BASE_URL="" # 默认为 https://ark.cn-beijing.volces.com/api/plan/v3
VOLCENGINE_AGENT_MODEL="" # 默认为 doubao-seed-evolving
# 火山引擎 Coding Plan (当 AI_PROVIDER="volcengine-coding" 时需要)：方舟 API Key；不要改成 /api/v3（不计入套餐、按量计费）；套餐不含语音合成
VOLCENGINE_CODING_API_KEY=""
VOLCENGINE_CODING_BASE_URL="" # 默认为 https://ark.cn-beijing.volces.com/api/coding/v3
VOLCENGINE_CODING_MODEL="" # 默认为 doubao-seed-evolving
# 火山引擎（免费试用）(当 AI_PROVIDER="volcengine-free" 时需要)：新用户每个模型有免费推理额度，开启「安心体验模式」后用完自动暂停不扣费
VOLCENGINE_FREE_API_KEY=""
VOLCENGINE_FREE_BASE_URL="" # 默认为 https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_FREE_MODEL="" # 默认为 doubao-seed-evolving

# 硅基流动中国站 (当 AI_PROVIDER="siliconflow" 时需要)：部分对话模型免费（仅文本输入，需实名认证）
SILICONFLOW_API_KEY=""
SILICONFLOW_BASE_URL="" # 默认为 https://api.siliconflow.cn/v1
SILICONFLOW_MODEL="" # 默认为 THUDM/GLM-Z1-9B-0414

# 硅基流动国际站 (当 AI_PROVIDER="siliconflow-global" 时需要)：独立账号与 Key，新用户有体验赠金
SILICONFLOW_GLOBAL_API_KEY=""
SILICONFLOW_GLOBAL_BASE_URL="" # 默认为 https://api.siliconflow.com/v1
SILICONFLOW_GLOBAL_MODEL="" # 默认为 Qwen/Qwen2.5-VL-7B-Instruct

# MiniMax Code OAuth (当 AI_PROVIDER="minimax-code" 时使用)：在网页“设置 → AI 设置”中登录账号，无需 API Key
MINIMAX_CODE_MODEL="" # 默认为 MiniMax-M3.1-Flash
MINIMAX_CODE_AUTO_CHECKIN="true" # 每日自动签到领取积分，设为 false 关闭

# Anthropic 配置 (当 AI_PROVIDER="anthropic" 时需要，也可用于兼容 Anthropic Messages API 的服务)
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="" # 可选，不含 /v1，默认为 https://api.anthropic.com
ANTHROPIC_MODEL="claude-sonnet-5-5" # 可选，默认为 claude-sonnet-5-5

# OpenAI 配置 (当 AI_PROVIDER="openai" 时需要)
OPENAI_API_KEY=""
OPENAI_BASE_URL="" # 可选，用于兼容的 API 服务
OPENAI_MODEL="gpt-6.1-sol" # 可选，默认为 gpt-6.1-sol

# Google Gemini 配置 (当 AI_PROVIDER="gemini" 时需要)
GOOGLE_API_KEY=""
GEMINI_BASE_URL="" # 可选，用于自定义 API 地址
GEMINI_MODEL="gemini-2.5-flash" # 可选，默认为 gemini-2.5-flash

# 日志配置
# 日志级别: trace, debug, info, warn, error, fatal
# 开发环境建议使用 debug，生产环境建议使用 info
LOG_LEVEL="debug"
# 设为 true 时开启 NextAuth 调试日志（默认 false）
# NEXTAUTH_DEBUG="false"
# 是否在生产环境标准输出中打印脱敏截断后的 AI 提示词与响应载荷（默认 false，仅输出标题与长度）
# LOG_AI_PAYLOADS="false"

# Database Debugging
# Set to "true" to enable SQL query logging
DEBUG_DB="false"

# Openclaw Agent API 配置
# 用于对接本地部署的 Openclaw agent 进行错题识别
OPENCLAW_API_URL="http://localhost:8080"  # Openclaw agent 服务地址
OPENCLAW_API_KEY=""  # Openclaw API 密钥
OPENCLAW_TIMEOUT=30000  # 请求超时时间（毫秒），默认30秒

# 本系统 API 认证模式配置
# 可选值: "credentials" (用户名密码登录，默认) 或 "apikey" (API Key认证)
OPENCLAW_AUTH_MODE="credentials"

# 本系统 API 密钥（用于 Openclaw agent 调用本系统）
# 仅当 OPENCLAW_AUTH_MODE=apikey 时需要配置
# 生成方式: openssl rand -hex 32
OPENCLAW_INTEGRATION_API_KEY=""

# 下面三项仅供命令行诊断，执行诊断时在终端导出。
# 未指定目标时脚本运行离线测试，无需凭据。
# WRONG_NOTEBOOK_URL=
# OPENCLAW_TEST_USER=
# OPENCLAW_TEST_PASSWORD=

# 微信小程序（miniprogram/ 目录）登录配置：在微信公众平台「开发管理 → 开发设置」查看
# 两项都留空时小程序登录接口返回 503，网页端不受影响。AppSecret 只放服务器环境变量，切勿提交或写进小程序代码
# WECHAT_MP_APPID=""
# WECHAT_MP_APPSECRET=""
# 小程序登录会话有效天数（默认 30，最多 365）
# WECHAT_MP_SESSION_TTL_DAYS="30"
