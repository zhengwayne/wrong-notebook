{
  "version": 1,
  "description": "OPT-04 / OPT-09 / E7 确定性验证与 LaTeX JSON 解析黄金用例（无付费 AI 调用）",
  "answerEquivalenceCases": [
    { "id": "ans-frac-decimal", "expected": "1/2", "actual": "0.5", "expectedStatus": "passed" },
    { "id": "ans-percent", "expected": "50%", "actual": "1/2", "expectedStatus": "passed" },
    { "id": "ans-latex-frac", "expected": "$\\frac{\\sqrt{2}}{2}$", "actual": "sqrt(2)/2", "expectedStatus": "passed" },
    { "id": "ans-missing-root", "expected": "3 或 -3", "actual": "-3", "expectedStatus": "failed" },
    { "id": "ans-missing-root-eq", "expected": "x=2 或 x=3", "actual": "x=2", "expectedStatus": "failed" },
    { "id": "ans-extra-root", "expected": "2 或 3", "actual": "2 或 3 或 4", "expectedStatus": "failed" },
    { "id": "ans-root-order", "expected": "2 或 3", "actual": "3 或 2", "expectedStatus": "passed" },
    { "id": "ans-set-notation", "expected": "{2, -2}", "actual": "x1=-2, x2=2", "expectedStatus": "passed" },
    { "id": "ans-plus-minus", "expected": "x = \\pm 4", "actual": "4 或 -4", "expectedStatus": "passed" },
    { "id": "ans-tuple-order", "expected": "(1, 2)", "actual": "(2, 1)", "expectedStatus": "failed" },
    { "id": "ans-tuple-equiv", "expected": "(1/2, 2)", "actual": "(0.5, 4/2)", "expectedStatus": "passed" },
    { "id": "ans-comma-not-or", "expected": "1, 2", "actual": "1", "expectedStatus": "failed" },
    { "id": "ans-comma-order", "expected": "1, 2", "actual": "2, 1", "expectedStatus": "failed" },
    { "id": "ans-multi-var-swap", "expected": "x=1, y=2", "actual": "y=2, x=1", "expectedStatus": "passed" },
    { "id": "ans-unit-mismatch", "expected": "5 cm", "actual": "5 m", "expectedStatus": "failed" },
    { "id": "ans-unit-missing", "expected": "5 cm", "actual": "5", "expectedStatus": "failed" },
    { "id": "ans-unit-alias", "expected": "5 cm", "actual": "5厘米", "expectedStatus": "passed" },
    { "id": "ans-subq-ok", "expected": "(1) 3 (2) 5", "actual": "(1) 3；(2) 5", "expectedStatus": "passed" },
    { "id": "ans-subq-missing", "expected": "(1) 3 (2) 5", "actual": "(1) 3", "expectedStatus": "failed" },
    { "id": "ans-subq-wrong", "expected": "(1) 3 (2) 5", "actual": "(1) 3 (2) 6", "expectedStatus": "failed" },
    { "id": "ans-algebra-equiv", "expected": "x+x", "actual": "2x", "expectedStatus": "passed" },
    { "id": "ans-algebra-diff", "expected": "x+1", "actual": "x+2", "expectedStatus": "failed" },
    { "id": "ans-unknown-macro", "expected": "\\vec{a}+\\vec{b}", "actual": "a+b", "expectedStatus": "unknown" }
  ],
  "computableCases": [
    { "id": "comp-expr-ok", "spec": { "type": "expression", "expression": "1/2+1/4", "expected": "0.75" }, "answerText": "3/4", "expectedPassed": true, "expectedComputable": true },
    { "id": "comp-expected-conflict", "spec": { "type": "expression", "expression": "2+2", "expected": "4" }, "answerText": "5", "expectedPassed": false },
    { "id": "comp-implicit-mult", "spec": { "type": "equation", "expression": "2x=6", "expected": "3" }, "answerText": "x=3", "expectedPassed": true, "expectedComputable": true },
    { "id": "comp-multi-roots-ok", "spec": { "type": "equation", "expression": "x^2-5x+6=0", "expected": "2 或 3" }, "answerText": "x=2 或 x=3", "expectedPassed": true, "expectedComputable": true },
    { "id": "comp-multi-roots-wrong", "spec": { "type": "equation", "expression": "x^2-5x+6=0", "expected": "2 或 4" }, "answerText": "2 或 4", "expectedPassed": false },
    { "id": "comp-const-eq-reject", "spec": { "type": "equation", "expression": "1=1", "expected": "1" }, "answerText": "1", "expectedPassed": false, "expectedComputable": false },
    { "id": "comp-euler-protect-ok", "spec": { "type": "equation", "expression": "e*x=2*e", "expected": "2" }, "answerText": "2", "expectedPassed": true, "expectedComputable": true },
    { "id": "comp-euler-protect-fail", "spec": { "type": "equation", "expression": "e*x=2*e", "expected": "1" }, "answerText": "1", "expectedPassed": false },
    { "id": "comp-euler-only-reject", "spec": { "type": "equation", "expression": "e=e", "expected": "1" }, "answerText": "1", "expectedPassed": false, "expectedComputable": false },
    { "id": "comp-numeric-ok", "spec": { "type": "numeric", "expression": "2.5e2", "expected": "250" }, "answerText": "250", "expectedPassed": true, "expectedComputable": true },
    { "id": "comp-numeric-var-reject", "spec": { "type": "numeric", "expression": "2*x", "expected": "4" }, "answerText": "4", "expectedPassed": false, "expectedComputable": false },
    { "id": "comp-unsafe-eval-reject", "spec": { "type": "expression", "expression": "eval(1+1)", "expected": "2" }, "answerText": "2", "expectedPassed": false, "expectedComputable": false }
  ],
  "latexJsonCases": [
    {
      "id": "json-latex-frac-times",
      "raw": "{\"questionText\":\"计算 $\\\\frac{1}{2} \\\\times 2$\",\"answer\":\"1\"}",
      "expectedSubstring": "\\frac{1}{2}",
      "targetField": "questionText"
    },
    {
      "id": "json-latex-single-slash-controls",
      "raw": "{\"q\":\"$\\frac{1}{2} \\times 2 \\binom{4}{2} \\neq 0 \\right) \\sqrt{2} \\begin{aligned}x&=1\\end{aligned}$\",\"a\":\"解：\\n第一步\\ta\\tto b\"}",
      "mustContainQ": ["\\frac{1}{2}", "\\times 2", "\\binom{4}{2}", "\\neq 0", "\\right)", "\\sqrt{2}", "\\begin{aligned}"],
      "mustEqualA": "解：\n第一步\ta\tto b"
    }
  ]
}
