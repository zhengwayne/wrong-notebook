/public/pdfjs/

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma


# App config (contains secrets)
/config/app-config.json
/config/setup-token
/config/setup-token.*.claimed
/config/initial-admin.json
/config/minimax-code.json
/config/background-tasks.json
/config/tts-cache/
dist-scripts

# Playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

